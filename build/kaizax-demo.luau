			ctx.Paint(field, "TextColor3", "TextFaint")
			ctx.Paint(stroke, "Color", "Stroke")
			ctx.Paint(label, "TextColor3", "TextFaint")
			field.BackgroundTransparency = 0.25
			stroke.Transparency = 0.5
			return
		end

		ctx.Paint(field, "BackgroundColor3", if focused then "SurfaceRaised" else if hovered then "Hover" else "SurfaceRaised")
		ctx.Paint(field, "TextColor3", "Text")
		ctx.Paint(stroke, "Color", if focused then "Accent" else if hovered then "StrokeStrong" else "Stroke")
		ctx.Paint(label, "TextColor3", "TextMuted")
		field.BackgroundTransparency = 0
		stroke.Transparency = 0

		Animation.play(field, current.Motion.Fast, {
			BackgroundColor3 = ctx.Color(if focused then "SurfaceRaised" else if hovered then "Hover" else "SurfaceRaised"),
			BackgroundTransparency = 0,
		}, { easing = "Quad" })
		Animation.play(stroke, current.Motion.Fast, {
			Color = ctx.Color(if focused then "Accent" else if hovered then "StrokeStrong" else "Stroke"),
			Transparency = 0,
		}, { easing = "Quad" })
	end

	local function commit()
		if committed ~= text then
			committed = text
			submitted:Fire(text)
			Util.safeCall(callback, text)
		end
	end

	local function updateClear()
		clearButton.Visible = text ~= "" and not disabled
	end

	applyColors(false)
	updateClear()

	bag:Add(field:GetPropertyChangedSignal("Text"):Connect(function()
		local nextText = field.Text
		if limit > 0 and #nextText > limit then
			nextText = string.sub(nextText, 1, limit)
			field.Text = nextText
		end
		text = nextText
		updateClear()
		changed:Fire(text)
	end))

	bag:Add(field.Focused:Connect(function()
		focused = true
		if options.ClearOnFocus and field.Text ~= "" then
			field.Text = ""
			text = ""
			updateClear()
		end
		applyColors(true)
	end))

	bag:Add(field.FocusLost:Connect(function()
		focused = false
		text = field.Text
		applyColors(true)
		commit()
	end))

	bag:Add(field.MouseEnter:Connect(function()
		if disabled then
			return
		end
		hovered = true
		applyColors(true)
	end))

	bag:Add(field.MouseLeave:Connect(function()
		if disabled then
			return
		end
		hovered = false
		applyColors(true)
	end))

	bag:Add(clearButton.Activated:Connect(function()
		if disabled then
			return
		end
		field.Text = ""
		text = ""
		updateClear()
		field:CaptureFocus()
		applyColors(true)
	end))

	local self = setmetatable({} :: any, TextInput) :: TextInput
	self.Instance = container
	self.Changed = changed
	self.Submitted = submitted

	function self:GetText(): string
		return text
	end

	function self:SetText(nextText: string, silent: boolean?)
		if limit > 0 and #nextText > limit then
			nextText = string.sub(nextText, 1, limit)
		end
		text = nextText
		committed = nextText
		field.Text = nextText
		updateClear()
		if not silent then
			changed:Fire(text)
			submitted:Fire(text)
			Util.safeCall(callback, text)
		end
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		field.TextEditable = not disabled
		field.Active = not disabled
		clearButton.Visible = text ~= "" and not disabled
		applyColors(true)
	end

	function self:SetVisible(visible: boolean)
		container.Visible = visible
	end

	function self:OnChanged(handler: (text: string) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:OnSubmitted(handler: (text: string) -> ()): Signal.Connection
		return submitted:Connect(handler)
	end

	function self:Destroy()
		bag:Clear()
		changed:DisconnectAll()
		submitted:DisconnectAll()
		container:Destroy()
	end

	container:SetAttribute("KaizaxComponent", "TextInput")
	ctx.Register(container, labelText)

	return self
end

return TextInput
	end

	__modules["Components/Toggle"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local Toggle = {}
Toggle.__index = Toggle

export type Options = {
	Text: string?,
	Default: boolean?,
	Disabled: boolean?,
	Callback: ((value: boolean) -> ())?,
}

export type Toggle = {
	Instance: Frame,
	Changed: Signal.Signal,
	GetValue: (self: Toggle) -> boolean,
	SetValue: (self: Toggle, value: boolean, silent: boolean?) -> (),
	Toggle: (self: Toggle, silent: boolean?) -> (),
	SetDisabled: (self: Toggle, disabled: boolean) -> (),
	SetVisible: (self: Toggle, visible: boolean) -> (),
	OnChanged: (self: Toggle, handler: (value: boolean) -> ()) -> Signal.Connection,
	Destroy: (self: Toggle) -> (),
}

function Toggle.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Toggle
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local value = options.Default == true
	local disabled = options.Disabled == true
	local hovered = false
	local callback = options.Callback
	local labelText = options.Text or "Toggle"

	local changed = Signal.new()
	local row, _, rowLabel = Base.row(ctx, parent, labelText)
	if rowLabel then
		rowLabel.Size = UDim2.new(1, -52, 1, 0)
	end

	local switch = Util.textButton({
		Name = "Switch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = theme.Palette.SurfaceRaised,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Active = not disabled,
	}, row)

	Util.corner(switch, 999)
	local stroke = Util.stroke(switch, 1)

	local knob = Util.frame({
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = theme.Palette.TextFaint,
		BorderSizePixel = 0,
	}, switch)

	Util.corner(knob, 999)

	local function targets(): (Color3, number, string, Color3, string, number)
		local current = ctx.GetTheme()

		if disabled then
			return current.Palette.SurfaceRaised, 0.4, "SurfaceRaised", current.Palette.TextFaint, "TextFaint", 0.7
		end

		if value then
			local fill = if hovered then current.Palette.Accent:Lerp(Color3.new(1, 1, 1), 0.06) else current.Palette.Accent
			return fill, 0, "Accent", current.Palette.OnAccent, "OnAccent", 1
		end

		local fill = if hovered then current.Palette.Hover else current.Palette.SurfaceRaised
		local knobColor = if hovered then current.Palette.TextMuted else current.Palette.TextFaint
		return fill, 0, if hovered then "Hover" else "SurfaceRaised", knobColor, if hovered then "TextMuted" else "TextFaint", 0
	end

	local function apply(animate: boolean)
		local fill, fillTransparency, fillRole, knobColor, knobRole, strokeTransparency = targets()
		local current = ctx.GetTheme()

		ctx.Paint(switch, "BackgroundColor3", fillRole)
		ctx.Paint(knob, "BackgroundColor3", knobRole)
		ctx.Paint(stroke, "Color", if value then "Accent" else "Stroke")

		local knobPosition = UDim2.new(0, if value then 22 else 2, 0.5, 0)
		local properties = {
			BackgroundColor3 = fill,
			BackgroundTransparency = fillTransparency,
		}

		if animate then
			Animation.play(switch, current.Motion.Normal, properties, {
				easing = "Quad",
			})
			Animation.play(knob, current.Motion.Normal, {
				BackgroundColor3 = knobColor,
				Position = knobPosition,
			}, {
				easing = "Quad",
				direction = "Out",
			})
			stroke.Transparency = strokeTransparency
		else
			switch.BackgroundColor3 = fill
			switch.BackgroundTransparency = fillTransparency
			knob.BackgroundColor3 = knobColor
			knob.Position = knobPosition
			stroke.Transparency = strokeTransparency
		end
	end

	local function setValue(nextValue: boolean, silent: boolean?)
		if value == nextValue or disabled then
			return
		end
		value = nextValue
		apply(true)
		changed:Fire(value)
		if not silent then
			Util.safeCall(callback, value)
		end
	end

	apply(false)

	bag:Add(switch.Activated:Connect(function()
		setValue(not value, false)
	end))

	bag:Add(switch.MouseEnter:Connect(function()
		if disabled then
			return
		end
		hovered = true
		apply(true)
	end))

	bag:Add(switch.MouseLeave:Connect(function()
		if disabled then
			return
		end
		hovered = false
		apply(true)
	end))

	local self = setmetatable({} :: any, Toggle) :: Toggle
	self.Instance = row
	self.Changed = changed

	function self:GetValue(): boolean
		return value
	end

	function self:SetValue(nextValue: boolean, silent: boolean?)
		setValue(nextValue, silent)
	end

	function self:Toggle(silent: boolean?)
		setValue(not value, silent)
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		switch.Active = not disabled
		apply(true)
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (value: boolean) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:Destroy()
		bag:Clear()
		changed:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "Toggle")
	ctx.Register(row, labelText)

	return self
end

return Toggle
	end

	__modules["Config"] = function()
--!strict

local HttpService = game:GetService("HttpService")

local Config = {}

local FOLDER = "Kaizax"
local FILE = "Kaizax/config.json"
local SAVE_DELAY = 0.5

local env: any = _G
pcall(function()
	if typeof(getgenv) == "function" then
		env = getgenv()
	end
end)

local function fn(name: string): ((...any) -> ())?
	local ok, value = pcall(function()
		return (env :: any)[name]
	end)
	if ok and typeof(value) == "function" then
		return value :: (...any) -> ()
	end
	return nil
end

local function numberPair(value: any): { X: number, Y: number }?
	if typeof(value) ~= "table" then
		return nil
	end
	local x = tonumber(value.X or value.x)
	local y = tonumber(value.Y or value.y)
	if not x or not y then
		return nil
	end
	return { X = x, Y = y }
end

local defaults = {
	Theme = "Default",
	ActiveTab = nil :: string?,
	ToggleKey = "RightShift",
	Position = nil :: { X: number, Y: number }?,
	Size = nil :: { X: number, Y: number }?,
	AutoReexecute = true,
	OnlySameGame = true,
	GlowEnabled = true,
	GlowPulse = true,
}

local data = table.clone(defaults)
local saveTask: thread? = nil

function Config.load(): typeof(data)
	data = table.clone(defaults)

	local isFile = fn("isfile")
	local isFolder = fn("isfolder")
	local read = fn("readfile")
	if not isFile or not isFolder or not read then
		return data
	end

	pcall(function()
		if not isFolder(FOLDER) or not isFile(FILE) then
			return
		end
		local raw = read(FILE)
		if typeof(raw) ~= "string" then
			return
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not ok or typeof(decoded) ~= "table" then
			return
		end

		if typeof(decoded.Theme) == "string" then
			data.Theme = decoded.Theme
		end
		if typeof(decoded.ActiveTab) == "string" then
			data.ActiveTab = decoded.ActiveTab
		end
		if typeof(decoded.ToggleKey) == "string" then
			data.ToggleKey = decoded.ToggleKey
		end
		data.Position = numberPair(decoded.Position)
		data.Size = numberPair(decoded.Size)
		if typeof(decoded.AutoReexecute) == "boolean" then
			data.AutoReexecute = decoded.AutoReexecute
		end
		if typeof(decoded.OnlySameGame) == "boolean" then
			data.OnlySameGame = decoded.OnlySameGame
		end
		if typeof(decoded.GlowEnabled) == "boolean" then
			data.GlowEnabled = decoded.GlowEnabled
		end
		if typeof(decoded.GlowPulse) == "boolean" then
			data.GlowPulse = decoded.GlowPulse
		end
	end)

	return data
end

function Config.get(key: string): any
	return data[key]
end

function Config.snapshot(): typeof(data)
	return table.clone(data)
end

local function writeNow()
	if saveTask then
		pcall(task.cancel, saveTask)
		saveTask = nil
	end

	local isFolder = fn("isfolder")
	local makeFolder = fn("makefolder")
	local write = fn("writefile")
	if not write then
		return
	end

	pcall(function()
		if isFolder and not isFolder(FOLDER) and makeFolder then
			makeFolder(FOLDER)
		end
		local encoded = HttpService:JSONEncode(data)
		if typeof(encoded) == "string" then
			write(FILE, encoded)
		end
	end)
end

function Config.saveSoon()
	if saveTask then
		pcall(task.cancel, saveTask)
	end
	saveTask = task.delay(SAVE_DELAY, writeNow)
end

function Config.set(key: string, value: any): boolean
	if data[key] == value then
		return false
	end
	if value == nil and data[key] == nil then
		return false
	end
	data[key] = value
	Config.saveSoon()
	return true
end

function Config.cancelSave()
	if saveTask then
		pcall(task.cancel, saveTask)
		saveTask = nil
	end
end

function Config.flush()
	writeNow()
end

return Config
	end

	__modules["Notification"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")

local Notification = {}

export type Options = Types.NotificationOptions

export type Manager = {
	Push: (self: Manager, options: Options) -> (),
	SetTheme: (self: Manager, theme: Types.Theme) -> (),
	Destroy: (self: Manager) -> (),
}

local KIND_ROLE: { [string]: string } = {
	info = "Info",
	success = "Success",
	warning = "Warning",
	error = "Danger",
}

local TOAST_WIDTH = 340
local TOAST_HEIGHT = 88
local TOAST_GAP = 8
local MAX_TOASTS = 4

function Notification.new(
	getTheme: () -> Types.Theme,
	parent: Instance
): Manager
	local toasts: { any } = {}
	local gui = Util.create("ScreenGui", {
		Name = "KaizaxNotifications",
		DisplayOrder = 1000,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, parent) :: ScreenGui

	local host = Util.frame({
		Name = "Stack",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(TOAST_WIDTH, 400),
	}, gui)

	local manager = {} :: Manager

	local function layout(animate: boolean)
		local theme = getTheme()

		for index, toast in toasts do
			local target = UDim2.new(1, if toast.state == "enter" then TOAST_WIDTH + 24 else 0, 0, (index - 1) * (TOAST_HEIGHT + TOAST_GAP))
			if toast.state == "enter" then
				continue
			end
			if animate then
				Animation.play(toast.frame, theme.Motion.Fast, {
					Position = target,
				}, { easing = "Quad" })
			else
				toast.frame.Position = target
			end
		end
	end

	local function remove(toast: any)
		if toast.removed then
			return
		end
		toast.removed = true

		local index = table.find(toasts, toast)
		if index then
			table.remove(toasts, index)
		end

		layout(true)

		local theme = getTheme()
		Animation.fade(toast.frame, 0, {
			Duration = theme.Motion.Fast,
			Easing = "Quad",
			Direction = "In",
			Tag = "KaizaxToast",
		})
		local exitTarget = UDim2.new(1, TOAST_WIDTH + 40, 0, toast.frame.Position.Y.Offset)
		local tween = Animation.play(toast.frame, theme.Motion.Fast, {
			Position = exitTarget,
		}, { easing = "Quad", direction = "In" })

		if tween then
			tween.Completed:Once(function()
				toast.frame:Destroy()
			end)
		else
			toast.frame:Destroy()
		end
	end

	local function push(options: Options)
		local theme = getTheme()
		local kind = options.Kind or "info"
		local role = KIND_ROLE[kind] or "Info"
		local duration = options.Duration
		if duration == nil then
			duration = 4
		end

		if #toasts >= MAX_TOASTS then
			remove(toasts[#toasts])
		end

		local frame = Util.frame({
			Name = `Notification_{kind}`,
			AnchorPoint = Vector2.new(1, 0),
			BackgroundColor3 = theme.Palette.SurfaceRaised,
			BorderSizePixel = 0,
			Position = UDim2.new(1, TOAST_WIDTH + 24, 0, 0),
			Size = UDim2.fromOffset(TOAST_WIDTH, TOAST_HEIGHT),
		}, host)
		Util.corner(frame, theme.Radius.Card)
		local stroke = Util.stroke(frame, 1)
		Util.paint(frame, "BackgroundColor3", "SurfaceRaised", theme)
		Util.paint(stroke, "Color", "Stroke", theme)

		local accent = Util.frame({
			Name = "Accent",
			BackgroundColor3 = theme.Palette[role],
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 10),
			Size = UDim2.new(0, 2, 1, -20),
		}, frame)
		Util.corner(accent, 1)
		Util.paint(accent, "BackgroundColor3", role, theme)

		local dot = Util.frame({
			Name = "Dot",
			BackgroundColor3 = theme.Palette[role],
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(16, 16),
			Size = UDim2.fromOffset(8, 8),
		}, frame)
		Util.corner(dot, 999)
		Util.paint(dot, "BackgroundColor3", role, theme)

		local message = options.Message or ""

		local title = Util.label({
			BackgroundTransparency = 1,
			Font = theme.Fonts.Medium,
			Size = UDim2.new(1, -70, 0, 20),
			Text = options.Title,
			TextColor3 = theme.Palette.Text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, frame)
		title.Position = UDim2.fromOffset(27, if message == "" then 20 else 8)
		Util.paint(title, "TextColor3", "Text", theme)

		local messageLabel = Util.label({
			BackgroundTransparency = 1,
			Font = theme.Fonts.Regular,
			Position = UDim2.fromOffset(16, 32),
			Size = UDim2.new(1, -32, 0, 38),
			Text = message,
			TextColor3 = theme.Palette.TextMuted,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Visible = message ~= "",
		}, frame)
		Util.paint(messageLabel, "TextColor3", "TextMuted", theme)

		local dismissable = options.Dismissable ~= false
		if dismissable then
			local closeButton = Util.textButton({
				Name = "Dismiss",
				AnchorPoint = Vector2.new(1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.new(1, -7, 0, 7),
				Size = UDim2.fromOffset(20, 20),
				Text = "",
				AutoButtonColor = false,
			}, frame)

			local barOne = Util.frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = theme.Palette.TextFaint,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(0.5, 0.5),
				Rotation = 45,
				Size = UDim2.fromOffset(8, 1),
			}, closeButton)
			Util.paint(barOne, "BackgroundColor3", "TextFaint", theme)

			local barTwo = Util.frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = theme.Palette.TextFaint,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(0.5, 0.5),
				Rotation = -45,
				Size = UDim2.fromOffset(8, 1),
			}, closeButton)
			Util.paint(barTwo, "BackgroundColor3", "TextFaint", theme)

			closeButton.Activated:Connect(function()
				remove(toast)
			end)
		end

		local progressTrack: Frame? = nil
		local progressFill: Frame? = nil

		if duration > 0 then
			progressTrack = Util.frame({
				Name = "ProgressTrack",
				BackgroundColor3 = theme.Palette.Stroke,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 16, 1, -10),
				Size = UDim2.new(1, -32, 0, 2),
			}, frame)
			Util.corner(progressTrack, 1)
			Util.paint(progressTrack, "BackgroundColor3", "Stroke", theme)

			progressFill = Util.frame({
				Name = "ProgressFill",
				BackgroundColor3 = theme.Palette[role],
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
			}, progressTrack)
			Util.corner(progressFill, 1)
			Util.paint(progressFill, "BackgroundColor3", role, theme)
		end

		local toast = {
			frame = frame,
			state = "enter",
			removed = false,
			hovering = false,
		}

		table.insert(toasts, 1, toast)
		layout(false)

		toast.state = "moving"
		Animation.play(frame, theme.Motion.Normal, {
			Position = UDim2.new(1, 0, 0, 0),
		}, { easing = "Quart", direction = "Out" })

		if duration > 0 and progressFill and progressTrack then
			local progressTween = Animation.play(progressFill, duration, {
				Size = UDim2.new(0, 0, 0, 2),
			}, { easing = "Linear" })

			frame.MouseEnter:Connect(function()
				toast.hovering = true
				if progressTween then
					progressTween:Pause()
				end
			end)

			frame.MouseLeave:Connect(function()
				toast.hovering = false
				if progressTween then
					progressTween:Play()
				end
			end)

			task.spawn(function()
				local remaining = duration
				while remaining > 0 and not toast.removed do
					local step = math.min(0.1, remaining)
					task.wait(step)
					if not toast.hovering then
						remaining -= step
					end
				end
				if not toast.removed then
					remove(toast)
				end
			end)
		end
	end

	function manager:Push(options: Options)
		push(options)
	end

	function manager:SetTheme(theme: Types.Theme)
		Util.applyTheme(gui, theme)
	end

	function manager:Destroy()
		for index = #toasts, 1, -1 do
			local toast = toasts[index]
			toast.removed = true
			toast.frame:Destroy()
		end
		table.clear(toasts)
		gui:Destroy()
	end

	return manager
end

return Notification
	end

