local QUEUE_NAMES = {
	"queue_on_teleport",
	"syn.queue_on_teleport",
	"fluxus.queue_on_teleport",
	"queue_on_tp",
	"queueonteleport",
	"queueontp",
}

local function nestedValue(root: any, path: string): any
	local value = root
	for part in string.gmatch(path, "[^%.]+") do
		if typeof(value) ~= "table" then
			return nil
		end
		value = value[part]
	end
	return value
end

local function queueFunction(): ((string) -> ())?
	for _, name in QUEUE_NAMES do
		local ok, value = pcall(function()
			return nestedValue(env, name)
		end)
		if ok and typeof(value) == "function" then
			return value :: (string) -> ()
		end
	end
	return nil
end

local function quote(text: string): string
	local escaped = tostring(text):gsub("\\", "\\\\"):gsub('"', '\\"')
	return '"' .. escaped .. '"'
end

function ReExecute.consumeReloaded(): boolean
	local ok, reloaded = pcall(function()
		return env[RELOADED_KEY] == true
	end)
	pcall(function()
		env[RELOADED_KEY] = nil
	end)
	return ok and reloaded == true
end

local function buildLoader(onlySameGame: boolean, gameId: string): string
	local sameGame = if onlySameGame then "true" else "false"
	return table.concat({
		"local f=", quote(ReExecute.SCRIPT_SOURCE), ";",
		"local g=_G;pcall(function() if typeof(getgenv)==\"function\" then g=getgenv() end end);",
		"task.spawn(function()",
		"if not game:IsLoaded() then game.Loaded:Wait() end;",
		"local P=game:GetService(\"Players\");local p=P.LocalPlayer;",
		"while not p do P:GetPropertyChangedSignal(\"LocalPlayer\"):Wait();p=P.LocalPlayer end;",
		"if ", sameGame, " and tostring(game.GameId)~=", quote(gameId), " then return end;",
		"g[", quote(RELOADED_KEY), "]=true;",
		"local okF,it=pcall(function() return typeof(isfile)==\"function\" and isfile(f) or false end);if not okF or not it then return end;",
		"local okR,s=pcall(function() return typeof(readfile)==\"function\" and readfile(f) or nil end);if not okR or typeof(s)~=\"string\" then return end;",
		"local okL,chunk=pcall(function() return typeof(loadstring)==\"function\" and loadstring(s) or nil end);if okL and chunk then pcall(chunk) end;",
		"end)",
	})
end

--- Watches LocalPlayer.OnTeleport and queues one short loader per teleport.
function ReExecute.start(getConfig: () -> any): () -> ()
	local queued = false
	local connection: RBXScriptConnection? = nil

	local function onTeleport(state: Enum.TeleportState)
		if state ~= Enum.TeleportState.Started and state ~= Enum.TeleportState.InProgress then
			return
		end
		if queued then
			return
		end
		queued = true

		local config = getConfig()
		if config.AutoReexecute ~= true then
			if ReExecute.DEBUG then
				print("[Kaizax] re-execute disabled")
			end
			return
		end

		local queue = queueFunction()
		if not queue then
			if ReExecute.DEBUG then
				print("[Kaizax] queue_on_teleport unavailable")
			end
			return
		end

		local loader = buildLoader(config.OnlySameGame == true, tostring(game.GameId))
		local ok, err = pcall(queue, loader)
		if ReExecute.DEBUG then
			if ok then
				print("[Kaizax] queued re-execute once")
			else
				warn(`[Kaizax] queue failed: {tostring(err)}`)
			end
		end
	end

	local function bind(player: Player?)
		if not player or connection then
			return
		end
		connection = player.OnTeleport:Connect(onTeleport)
	end

	bind(Players.LocalPlayer)
	local watch: RBXScriptConnection? = nil
	if not connection then
		watch = Players:GetPropertyChangedSignal("LocalPlayer"):Connect(function()
			bind(Players.LocalPlayer)
			if connection and watch then
				watch:Disconnect()
				watch = nil
			end
		end)
	end

	return function()
		if connection then
			connection:Disconnect()
			connection = nil
		end
		if watch then
			watch:Disconnect()
			watch = nil
		end
	end
end

return ReExecute
	end

	__modules["Section"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Base = __require("Components/Base")
local Button = __require("Components/Button")
local Toggle = __require("Components/Toggle")
local Checkbox = __require("Components/Checkbox")
local Slider = __require("Components/Slider")
local Dropdown = __require("Components/Dropdown")
local MultiDropdown = __require("Components/MultiDropdown")
local TextInput = __require("Components/TextInput")
local Keybind = __require("Components/Keybind")
local ColorPicker = __require("Components/ColorPicker")

local Section = {}
Section.__index = Section

export type SectionOptions = {
	Name: string,
	Description: string?,
}

export type LabelOptions = {
	Text: string,
	ColorRole: string?,
	Size: number?,
}

export type ParagraphOptions = {
	Text: string,
	ColorRole: string?,
	Size: number?,
}

export type StatusOptions = {
	Text: string,
	Value: string?,
	Kind: Types.StatusKind?,
	Pulse: boolean?,
}

export type Status = {
	Instance: Frame,
	SetStatus: (self: Status, value: string, kind: Types.StatusKind?, pulse: boolean?) -> (),
	SetVisible: (self: Status, visible: boolean) -> (),
	Destroy: (self: Status) -> (),
}

type SearchEntry = {
	row: GuiObject,
	text: string?,
	isControl: boolean,
}

local STATUS_ROLES: { [string]: string } = {
	neutral = "TextMuted",
	info = "Info",
	success = "Success",
	warning = "Warning",
	danger = "Danger",
}

local function contains(haystack: string, needle: string): boolean
	return string.find(string.lower(haystack), string.lower(needle), 1, true) ~= nil
end

local function asOptions(value: any, defaultKey: string): any
	if typeof(value) == "string" then
		return { [defaultKey] = value }
	end
	return value or {}
end

function Section.new(
	baseCtx: Types.UIContext,
	parent: Instance,
	options: SectionOptions
): any
	local theme = baseCtx.GetTheme()
	local entries: { SearchEntry } = {}
	local components: { any } = {}
	local query = ""
	local titleText = options.Name
	local descriptionText = options.Description
	local order = 1

	local root = Util.frame({
		Name = `Section_{titleText}`,
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Palette.Surface,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
	}, parent)

	Util.corner(root, theme.Radius.Card)
	Util.gradient(root, "PanelShade", 90, theme)
	local stroke = Util.stroke(root, 1)
	baseCtx.Paint(root, "BackgroundColor3", "Surface")
	baseCtx.Paint(stroke, "Color", "Stroke")
	Util.padding(root, 24, 20)
	Util.list(root, 12)

	local header = Util.frame({
		Name = "Header",
		BackgroundTransparency = 1,
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 24),
	}, root)

	local title = Base.text(baseCtx, header, titleText, {
		Font = theme.Fonts.Medium,
		Size = 15,
		ColorRole = "Text",
	})
	title.Position = UDim2.fromOffset(0, 0)
	title.Size = UDim2.fromScale(1, 1)

	local headerRule = Util.frame({
		Name = "HeaderRule",
		BackgroundColor3 = theme.Palette.Stroke,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 1),
	}, root)
	baseCtx.Paint(headerRule, "BackgroundColor3", "Stroke")

	local description: TextLabel? = nil
	if descriptionText and descriptionText ~= "" then
		description = Base.text(baseCtx, root, descriptionText, {
			Font = theme.Fonts.Regular,
			Size = 13,
			ColorRole = "TextMuted",
			Wrapped = true,
		})
		description.AutomaticSize = Enum.AutomaticSize.Y
		description.Size = UDim2.new(1, 0, 0, 0)
		description.LineHeight = 1.4
		description.LayoutOrder = 2
		order = 2
	end

	local content = Util.frame({
		Name = "Content",
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, root)

	Util.list(content, 12)

	if description then
		description.Parent = content
	end

	local function register(row: GuiObject, searchText: string?)
		table.insert(entries, {
			row = row,
			text = searchText,
			isControl = searchText ~= nil,
		})
	end

	local ctx: Types.UIContext = table.clone(baseCtx)
	ctx.Register = register

	local function track(component: any): any
		table.insert(components, component)
		return component
	end

	local function nextOrder(): number
		order += 1
		return order
	end

	local function filterRows()
		local headingMatch = query ~= ""
			and (contains(titleText, query) or (descriptionText ~= nil and contains(descriptionText, query)))

		local anyControl = false
		for _, entry in entries do
			if entry.row.Parent then
				local visible: boolean
				if query == "" then
					visible = true
				elseif headingMatch then
					visible = true
				elseif entry.isControl and entry.text then
					visible = contains(entry.text, query)
				else
					visible = false
				end

				entry.row.Visible = visible
				if visible and entry.isControl then
					anyControl = true
				end
			end
		end

		return query == "" or headingMatch or anyControl
	end

	local section = setmetatable({} :: any, Section) :: any
	section.Instance = root

	function section:_ApplySearch(nextQuery: string): boolean
		local trimmed = string.gsub(nextQuery or "", "^%s*(.-)%s*$", "%1")
		query = string.lower(trimmed)
		local hasMatch = filterRows()
		root.Visible = query == "" or hasMatch
		return hasMatch
	end

	function section:_GetTitle(): string
		return titleText
	end

	function section:SetVisible(visible: boolean)
		root.Visible = visible
	end

	function section:CreateButton(value: any): any
		local opts = asOptions(value, "Text")
		local component = Button.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateToggle(value: any): any
		local opts = asOptions(value, "Text")
		local component = Toggle.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateCheckbox(value: any): any
		local opts = asOptions(value, "Text")
		local component = Checkbox.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateSlider(value: any): any
		local opts = asOptions(value, "Text")
		local component = Slider.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateDropdown(value: any): any
		local opts = asOptions(value, "Text")
		local component = Dropdown.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateMultiDropdown(value: any): any
		local opts = asOptions(value, "Text")
		local component = MultiDropdown.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateTextInput(value: any): any
		local opts = asOptions(value, "Text")
		local component = TextInput.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateKeybind(value: any): any
		local opts = asOptions(value, "Text")
		local component = Keybind.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateColorPicker(value: any): any
		local opts = asOptions(value, "Text")
		local component = ColorPicker.new(ctx, content, opts)
		component.Instance.LayoutOrder = nextOrder()
		return track(component)
	end

	function section:CreateLabel(value: any): TextLabel
		local opts: LabelOptions = asOptions(value, "Text")
		local label = Base.text(ctx, content, opts.Text, {
			Font = theme.Fonts.Regular,
			Size = opts.Size or 13,
			ColorRole = opts.ColorRole or "TextMuted",
		})
		label.LayoutOrder = nextOrder()
		label.Size = UDim2.new(1, 0, 0, 18)
		register(label, nil)
		return label
	end

	function section:CreateParagraph(value: any): TextLabel
		local opts: ParagraphOptions = asOptions(value, "Text")
		local paragraph = Base.text(ctx, content, opts.Text, {
			Font = theme.Fonts.Regular,
			Size = opts.Size or 13,
			ColorRole = opts.ColorRole or "TextMuted",
			Wrapped = true,
		})
		paragraph.AutomaticSize = Enum.AutomaticSize.Y
		paragraph.Size = UDim2.new(1, 0, 0, 0)
		paragraph.LineHeight = 1.4
		paragraph.LayoutOrder = nextOrder()
		register(paragraph, nil)
		return paragraph
	end

	function section:CreateDivider(): Frame
		local divider = Util.frame({
			BackgroundColor3 = theme.Palette.Stroke,
			BorderSizePixel = 0,
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, 1),
		}, content)
		ctx.Paint(divider, "BackgroundColor3", "Stroke")
		register(divider, nil)
		return divider
	end

	function section:CreateSpacer(height: number?): Frame
		local spacer = Util.frame({
			BackgroundTransparency = 1,
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, height or 4),
		}, content)
		register(spacer, nil)
		return spacer
	end

	function section:CreateStatus(value: any): Status
		local opts: StatusOptions = asOptions(value, "Text")
		local kind: Types.StatusKind = opts.Kind or "neutral"
		local pulseEnabled = opts.Pulse == true

		local row, _, statusLabel = Base.row(ctx, content, opts.Text, 32)
		row.LayoutOrder = nextOrder()
		row.Name = "Status"
		if statusLabel then
			statusLabel.Size = UDim2.new(1, -110, 1, 0)
		end

		local group = Util.frame({
			AnchorPoint = Vector2.new(1, 0.5),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(0, 20),
		}, row)

		Util.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 7),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, group)

		local dotHolder = Util.frame({
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(10, 10),
		}, group)

		local halo = Util.frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(6, 6),
		}, dotHolder)
		Util.corner(halo, 999)

		local dot = Util.frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = theme.Palette.TextMuted,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(6, 6),
			ZIndex = 2,
		}, dotHolder)
		Util.corner(dot, 999)

		local haloScale = Util.create("UIScale", {
			Scale = 1,
		}, halo) :: UIScale

		local valueLabel = Base.text(ctx, group, opts.Value or "Ready", {
			Font = theme.Fonts.Mono,
			Size = 12,
			ColorRole = STATUS_ROLES[kind] or "TextMuted",
			XAlign = Enum.TextXAlignment.Right,
		})
		valueLabel.AutomaticSize = Enum.AutomaticSize.X
		valueLabel.Size = UDim2.fromOffset(0, 20)
		valueLabel.TextTruncate = Enum.TextTruncate.None

		local pulseTween: Tween? = nil

		local function stopPulse()
			Animation.cancel(pulseTween)
			pulseTween = nil
			haloScale.Scale = 1
			halo.BackgroundTransparency = 1
		end

		local function applyPulse()
			stopPulse()
			if not pulseEnabled then
				return
			end

			halo.BackgroundTransparency = 0.55
			local role = STATUS_ROLES[kind] or "TextMuted"
			ctx.Paint(halo, "BackgroundColor3", role)
			halo.BackgroundColor3 = ctx.Color(role)

			pulseTween = Animation.play(haloScale, 1.5, {
				Scale = 2.2,
			}, {
				easing = "Sine",
				direction = "Out",
				repeatCount = -1,
				reverses = true,
			})
		end

		local function paintStatus(animate: boolean?)
			local role = STATUS_ROLES[kind] or "TextMuted"
			local color = ctx.Color(role)

			if animate then
				Util.paint(dot, "BackgroundColor3", role)
				Util.paint(valueLabel, "TextColor3", role)
				local motion = Animation.MOTION.Status
				Animation.play(dot, motion.Duration, {
					BackgroundColor3 = color,
				}, { easing = motion.Easing, direction = motion.Direction })
				Animation.play(valueLabel, motion.Duration, {
					TextColor3 = color,
				}, { easing = motion.Easing, direction = motion.Direction })
			else
				ctx.Paint(dot, "BackgroundColor3", role)
				ctx.Paint(valueLabel, "TextColor3", role)
				dot.BackgroundColor3 = color
				valueLabel.TextColor3 = color
			end
			applyPulse()
		end

		dot:SetAttribute("KaizaxStatusDot", true)
		paintStatus(false)

		local status = {} :: Status
		status.Instance = row

		function status:SetStatus(nextValue: string, nextKind: Types.StatusKind?, nextPulse: boolean?)
			valueLabel.Text = nextValue
			if nextKind then
				kind = nextKind
			end
			if nextPulse ~= nil then
				pulseEnabled = nextPulse
			end
			paintStatus(true)
		end

		function status:SetVisible(visible: boolean)
			row.Visible = visible
		end

		function status:Destroy()
			stopPulse()
			row:Destroy()
		end

		register(row, opts.Text)
		track(status)
		return status
	end

	function section:Destroy()
		for _, component in components do
			if component.Destroy then
				component:Destroy()
			end
		end
		table.clear(components)
		root:Destroy()
	end

	return section
end

return Section
	end

	__modules["Signal"] = function()
--!strict

-- Small synchronous signal used for component change notifications. Handlers
-- are isolated with pcall so one bad consumer cannot break the UI or the rest
-- of the listeners.

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, handler: (...any) -> ()) -> Connection,
	Once: (self: Signal, handler: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	DisconnectAll: (self: Signal) -> (),
	ListenerCount: (self: Signal) -> number,
}

local Signal = {}

function Signal.new(): Signal
	local listeners: { [Connection]: (...any) -> () } = {}

	local signal = {} :: Signal

	function signal:Connect(handler: (...any) -> ()): Connection
		local connection = {
			Connected = true,
			Disconnect = function() end,
		} :: Connection

		function connection:Disconnect()
			if not self.Connected then
				return
			end
			self.Connected = false
			listeners[self] = nil
		end

		listeners[connection] = handler
		return connection
	end

	function signal:Once(handler: (...any) -> ()): Connection
		local connection
		connection = self:Connect(function(...)
			(connection :: Connection):Disconnect()
			handler(...)
		end)
		return connection
	end

	function signal:Fire(...: any)
		local snapshot = {}
		for connection, handler in listeners do
			if connection.Connected then
				table.insert(snapshot, { connection, handler })
			end
		end

		for _, entry in snapshot do
			local connection = entry[1] :: Connection
			local handler = entry[2] :: (...any) -> ()
			if connection.Connected then
				local ok, err = pcall(handler, ...)
				if not ok then
					warn(`[Kaizax] signal handler failed: {tostring(err)}`)
				end
			end
		end
	end

	function signal:DisconnectAll()
		for connection in listeners do
			connection.Connected = false
		end
		table.clear(listeners)
	end

	function signal:ListenerCount(): number
		local count = 0
		for connection in listeners do
			if connection.Connected then
				count += 1
			end
		end
		return count
	end

	return signal
end

return Signal
	end

	__modules["SubTab"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Section = __require("Section")

local SubTab = {}
SubTab.__index = SubTab

local GUTTER = 20

export type Options = {
	Name: string,
}

export type SubTab = {
	Instance: ScrollingFrame,
	Name: string?,
	CreateSection: (self: SubTab, options: any) -> any,
	Select: (self: SubTab) -> (),
	GetName: (self: SubTab) -> string?,
	Destroy: (self: SubTab) -> (),
}

function SubTab.new(
	ctx: Types.UIContext,
	parent: Instance,
	name: string?,
	columns: number,
	onSelect: ((subtab: any) -> ())?,
	selectable: boolean?
): SubTab
	local theme = ctx.GetTheme()
	local sections: { any } = {}
	local matchCount = 0
	local active = false
	local nextColumn = 1

	local scroller = Util.scrollingFrame({
		Name = if name then `SubTab_{name}` else "SubTab_General",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = theme.Palette.StrokeStrong,
		ScrollBarImageTransparency = 0.15,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
	}, parent)
	Util.paint(scroller, "ScrollBarImageColor3", "StrokeStrong", theme)
	scroller.Visible = false

	local holder = Util.frame({
		Name = "Content",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(GUTTER, 20),
		Size = UDim2.new(1, -(GUTTER * 2), 0, 0),
	}, scroller)

	Util.list(holder, 0)

	local columnHolder = Util.frame({
		Name = "Columns",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
	}, holder)

	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Padding = UDim.new(0, 16),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, columnHolder)

	local function makeColumn(index: number): Frame
		local column = Util.frame({
			Name = `Column_{index}`,
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Size = UDim2.new(0.5, -6, 0, 0),
		}, columnHolder)
		Util.list(column, 16)
		return column
	end

	local columnOne = makeColumn(1)
	local columnTwo = makeColumn(2)
	local columnFrames = { columnOne, columnTwo }

	if columns <= 1 then
		columnTwo.Visible = false
		columnOne.Size = UDim2.new(1, 0, 0, 0)
	end

	local spacer = Util.frame({
		Name = "BottomSpace",
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 52),
	}, holder)

	local subtab = setmetatable({} :: any, SubTab) :: SubTab
	subtab.Instance = scroller
	subtab.Name = name

	function subtab:CreateSection(options: any): any
		local opts = if typeof(options) == "string" then { Name = options } else (options or {})
		local columnIndex = 1
		if columns > 1 then
			columnIndex = if opts.Column == 2 then 2 elseif opts.Column == 1 then 1 else nextColumn
			if opts.Column == nil then
				nextColumn = if nextColumn == 1 then 2 else 1
			end
		end

		local section = Section.new(ctx, columnFrames[columnIndex], {
			Name = opts.Name or "Section",
			Description = opts.Description,
		})

		table.insert(sections, section)
		section:_ApplySearch("")
		return section
	end

	function subtab:Select()
		if not selectable then
			return
		end
		if onSelect then
			onSelect(subtab)
		end
	end

	function subtab:GetName(): string?
		return name
	end

	function subtab:_SetActive(value: boolean)
		local wasActive = active
		active = value
		scroller.Visible = value

		if value and not wasActive then
			holder.Position = UDim2.fromOffset(GUTTER, 28)
			Animation.play(holder, ctx.GetTheme().Motion.Slow, {
				Position = UDim2.fromOffset(GUTTER, 20),
			}, { easing = "Sine", direction = "InOut" })
		elseif not value then
			holder.Position = UDim2.fromOffset(GUTTER, 20)
		end
	end

	function subtab:_IsActive(): boolean
		return active
	end

	function subtab:_ApplySearch(query: string, forceVisible: boolean?): number
		local count = 0
		for _, section in sections do
			local matches = if forceVisible then true else section:_ApplySearch(query)
			if matches then
				count += 1
			end
		end
		matchCount = count
		return count
	end

	function subtab:_GetMatchCount(): number
		return matchCount
	end

	function subtab:_GetSections(): { any }
		return sections
	end

	function subtab:Destroy()
		for _, section in sections do
			section:Destroy()
		end
		table.clear(sections)
		scroller:Destroy()
	end

	return subtab
end

return SubTab
	end

	__modules["Tab"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Base = __require("Components/Base")
local SubTab = __require("SubTab")

local Tab = {}
Tab.__index = Tab

local GUTTER = 20

export type Options = {
	Name: string,
	Description: string?,
	SubTabs: { { Name: string, Columns: number? } }?,
}

export type Tab = {
	Instance: Frame,
	Name: string,
	CreateSection: (self: Tab, options: any) -> any,
	CreateSubTab: (self: Tab, name: string, columns: number?) -> any,
	SelectSubTab: (self: Tab, target: any) -> (),
	GetSubTabs: (self: Tab) -> { any },
	SetVisible: (self: Tab, visible: boolean) -> (),
	PlayIntro: (self: Tab, animate: boolean?) -> (),
	StopTransition: (self: Tab) -> (),
	Destroy: (self: Tab) -> (),
}

type ButtonEntry = {
	button: TextButton,
	label: TextLabel,
	underline: Frame,
}

function Tab.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Tab
	local theme = ctx.GetTheme()
	local titleText = options.Name
	local description = options.Description or ""
	local subtabs: { any } = {}
	local buttons: { [any]: ButtonEntry } = {}
	local current: any = nil

	local root = Util.frame({
		Name = `Tab_{titleText}`,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}, parent)
	root.Visible = false

	local header = Util.frame({
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, theme.Window.PageHeader),
	}, root)

	local title = Base.text(ctx, header, titleText, {
		Font = theme.Fonts.Medium,
		Size = 28,
		ColorRole = "Text",
	})
	title.Position = UDim2.fromOffset(GUTTER, 16)
	title.Size = UDim2.new(0.56, -GUTTER, 0, 34)

	local subtitle = Base.text(ctx, header, description, {
		Font = theme.Fonts.Medium,
		Size = 14,
		ColorRole = "TextMuted",
		Truncate = false,
	})
	subtitle.Position = UDim2.fromOffset(GUTTER, 57)
	subtitle.Size = UDim2.new(0.56, -GUTTER, 0, 24)
	subtitle.Visible = description ~= ""

	local bar = Util.frame({
		Name = "SubTabBar",
		AnchorPoint = Vector2.new(1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = theme.Palette.Surface,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -GUTTER, 0, 24),
		Size = UDim2.fromOffset(0, 36),
		Visible = false,
	}, header)
	Util.corner(bar, theme.Radius.Element)
	local barStroke = Util.stroke(bar, 1)
	ctx.Paint(bar, "BackgroundColor3", "Surface")
	ctx.Paint(barStroke, "Color", "Stroke")
	Util.padding(bar, 4, 4)

	local barLayout = Util.list(bar, 2, Enum.FillDirection.Horizontal)
	barLayout.VerticalAlignment = Enum.VerticalAlignment.Center

	local divider = Util.frame({
		Name = "Divider",
		BackgroundColor3 = theme.Palette.Stroke,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, theme.Window.PageHeader),
		Size = UDim2.new(1, 0, 0, 1),
	}, root)
	ctx.Paint(divider, "BackgroundColor3", "Stroke")

	local body = Util.frame({
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, theme.Window.PageHeader + 1),
		Size = UDim2.new(1, 0, 1, -(theme.Window.PageHeader + 1)),
	}, root)

	local empty = Base.text(ctx, body, "No controls match your search.", {
		Font = theme.Fonts.Regular,
		Size = 12,
		ColorRole = "TextFaint",
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Center,
		YAlign = Enum.TextYAlignment.Center,
	})
	empty.Size = UDim2.fromScale(1, 1)
	empty.Visible = false

	local tab = setmetatable({} :: any, Tab) :: Tab
	tab.Instance = root
	tab.Name = titleText

	local function paintButton(subtab: any, active: boolean, hovered: boolean)
		local entry = buttons[subtab]
		if not entry then
			return
		end

		local current = ctx.GetTheme()
		local backgroundRole = if active then "SurfaceRaised" elseif hovered then "Hover" else "Surface"
		local labelRole = if active then "Text" elseif hovered then "Text" else "TextMuted"

		ctx.Paint(entry.button, "BackgroundColor3", backgroundRole)
		ctx.Paint(entry.label, "TextColor3", labelRole)
		entry.underline.Visible = active
		entry.underline.BackgroundTransparency = if active then 0.4 else 1
		Animation.play(entry.underline, current.Motion.Fast, {
			BackgroundTransparency = if active then 0 else 1,
		}, { easing = "Quad" })
		Animation.play(entry.button, current.Motion.Fast, {
			BackgroundColor3 = ctx.Color(backgroundRole),
			BackgroundTransparency = if active or hovered then 0 else 1,
		}, { easing = "Quad" })
		Animation.play(entry.label, current.Motion.Fast, {
			TextColor3 = ctx.Color(labelRole),
		}, { easing = "Quad" })
	end

	local function selectSubTab(target: any)
		if current == target then
			return
		end
		current = target
		for item in buttons do
			paintButton(item, item == target, false)
		end
		for _, subtab in subtabs do
			subtab:_SetActive(subtab == target)
		end
	end

	local function addSubTab(name: string, columns: number?): any
		local subtab = SubTab.new(ctx, body, name, columns or 1, function(chosen)
			selectSubTab(chosen)
		end, true)

		table.insert(subtabs, subtab)

		local button = Util.textButton({
			Name = `SubTabButton_{name}`,
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = theme.Palette.Surface,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			LayoutOrder = #subtabs,
			Size = UDim2.fromOffset(0, 28),
			Text = "",
			AutoButtonColor = false,
		}, bar)
		Util.corner(button, theme.Radius.Element)

		local label = Base.text(ctx, button, name, {
			Font = theme.Fonts.Medium,
			Size = 13,
			ColorRole = "TextMuted",
			XAlign = Enum.TextXAlignment.Center,
		})
		label.AutomaticSize = Enum.AutomaticSize.X
		label.Size = UDim2.new(0, 0, 1, 0)
		Util.padding(button, 12, 0)

		local underline = Util.frame({
			Name = "Underline",
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = theme.Palette.Accent,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.new(1, -16, 0, 2),
			Visible = false,
		}, button)
		Util.corner(underline, 1)
		ctx.Paint(underline, "BackgroundColor3", "Accent")

		buttons[subtab] = {
			button = button,
			label = label,
			underline = underline,
		}

		button.MouseEnter:Connect(function()
			paintButton(subtab, current == subtab, true)
		end)
		button.MouseLeave:Connect(function()
			paintButton(subtab, current == subtab, false)
		end)
		button.Activated:Connect(function()
			selectSubTab(subtab)
		end)

		return subtab
	end

	local provided = options.SubTabs or {}
	if #provided == 0 then
		addSubTab("General", 1)
	else
		for _, entry in provided do
			addSubTab(entry.Name, entry.Columns)
		end
	end

	if #subtabs > 1 then
		bar.Visible = true
	end

	if subtabs[1] then
		selectSubTab(subtabs[1])
	end

	function tab:CreateSection(value: any): any
		return current:CreateSection(value)
	end

	function tab:CreateSubTab(name: string, columns: number?): any
		for _, subtab in subtabs do
			if subtab:GetName() == name then
				selectSubTab(subtab)
				return subtab
			end
		end

		local subtab = addSubTab(name, columns)
		bar.Visible = true
		selectSubTab(subtab)
		return subtab
	end

	function tab:SelectSubTab(target: any)
		if typeof(target) == "string" then
			for _, subtab in subtabs do
				if subtab:GetName() == target then
					selectSubTab(subtab)
					return
				end
			end
		elseif buttons[target] then
			selectSubTab(target)
		end
	end

	function tab:GetSubTabs(): { any }
		return subtabs
	end

	local finalBodyPosition = UDim2.fromOffset(0, theme.Window.PageHeader + 1)
	local finalTitlePosition = UDim2.fromOffset(GUTTER, 16)
	local finalSubtitlePosition = UDim2.fromOffset(GUTTER, 58)
	local transitionId = 0
	local transitionState = "idle"
	local sectionFinals: { [Instance]: UDim2 } = {}

	local function stopPageMotion()
		transitionId += 1
		Animation.stopTagged(root, "KaizaxPage")
	end

	local function pageSections(): { any }
		local result: { any } = {}
		if current then
			for _, section in current:_GetSections() do
				if section.Instance and section.Instance.Visible and #result < 5 then
					result[#result + 1] = section
				end
			end
		end
		return result
	end

	local function restorePage()
		body.Position = finalBodyPosition
		title.Position = finalTitlePosition
		subtitle.Position = finalSubtitlePosition
		Animation.fade(header, 1, { Duration = 0, Tag = "KaizaxPage" })
		Animation.fade(divider, 1, { Duration = 0, Tag = "KaizaxPage" })
		Animation.fade(empty, 1, { Duration = 0, Tag = "KaizaxPage" })
		for _, section in pageSections() do
			Animation.fade(section.Instance, 1, { Duration = 0, Tag = "KaizaxPage" })
		end
	end

	local function playEnter(animate: boolean?)
		local continueEnter = transitionState == "enter"
		stopPageMotion()
		local generation = transitionId
		transitionState = "enter"
		root.Visible = true

		local sections = pageSections()
		if not animate or not Animation.enabled() or Animation.reducedMotion() then
			restorePage()
			transitionState = "idle"
			return
		end

		local enter = Animation.MOTION.Enter
		if not continueEnter then
			body.Position = UDim2.fromOffset(0, finalBodyPosition.Y.Offset + 12)
			title.Position = UDim2.fromOffset(finalTitlePosition.X.Offset - 6, finalTitlePosition.Y.Offset)
			subtitle.Position = UDim2.fromOffset(finalSubtitlePosition.X.Offset - 6, finalSubtitlePosition.Y.Offset)
			Animation.fade(header, 0, { Duration = 0, Tag = "KaizaxPage" })
			Animation.fade(divider, 0, { Duration = 0, Tag = "KaizaxPage" })
			Animation.fade(empty, 0, { Duration = 0, Tag = "KaizaxPage" })
			for _, section in sections do
				Animation.fade(section.Instance, 0, { Duration = 0, Tag = "KaizaxPage" })
			end
		end

		Animation.fade(header, 1, {
			Duration = enter.Duration,
			Easing = enter.Easing,
			Direction = enter.Direction,
			Tag = "KaizaxPage",
		})
		Animation.fade(divider, 1, {
			Duration = enter.Duration,
			Easing = enter.Easing,
			Direction = enter.Direction,
			Tag = "KaizaxPage",
		})
		Animation.fade(empty, 1, {
			Duration = enter.Duration,
			Easing = enter.Easing,
			Direction = enter.Direction,
			Tag = "KaizaxPage",
		})

		Animation.play(title, enter.Duration, {
			Position = finalTitlePosition,
		}, { easing = enter.Easing, direction = enter.Direction, tag = "KaizaxPage" })
		Animation.play(subtitle, enter.Duration, {
			Position = finalSubtitlePosition,
		}, { easing = enter.Easing, direction = enter.Direction, tag = "KaizaxPage" })
		Animation.play(body, enter.Duration, {
			Position = finalBodyPosition,
		}, { easing = enter.Easing, direction = enter.Direction, tag = "KaizaxPage" })

		for index, section in sections do
			local finalPosition = sectionFinals[section.Instance] or Animation.integer(section.Instance.Position)
			sectionFinals[section.Instance] = finalPosition
			local startPosition = UDim2.new(
				finalPosition.X.Scale,
				finalPosition.X.Offset,
				finalPosition.Y.Scale,
				finalPosition.Y.Offset + 8
			)
			if not continueEnter then
				section.Instance.Position = startPosition
			end
			local delay = (index - 1) * Animation.MOTION.Stagger
			Animation.fade(section.Instance, 1, {
				Duration = enter.Duration,
				Easing = enter.Easing,
				Direction = enter.Direction,
				Delay = delay,
				Tag = "KaizaxPage",
			})
			Animation.play(section.Instance, enter.Duration, {
				Position = finalPosition,
			}, {
				easing = enter.Easing,
				direction = enter.Direction,
				delay = delay,
				tag = "KaizaxPage",
			})
			task.delay(enter.Duration + delay + 0.02, function()
				if generation == transitionId and section.Instance.Parent then
					section.Instance.Position = finalPosition
				end
			end)
		end

		task.delay(enter.Duration + (#sections * Animation.MOTION.Stagger) + 0.03, function()
			if generation == transitionId then
				restorePage()
				transitionState = "idle"
			end
		end)
	end

	local function playExit(animate: boolean?)
		stopPageMotion()
		local generation = transitionId
		if not root.Visible then
			restorePage()
			return
		end

		if not animate or not Animation.enabled() or Animation.reducedMotion() then
			root.Visible = false
			restorePage()
			transitionState = "idle"
			return
		end

		transitionState = "exit"
		local exit = Animation.MOTION.Exit
		local sections = pageSections()

		Animation.fade(header, 0, {
			Duration = exit.Duration,
			Easing = exit.Easing,
			Direction = exit.Direction,
			Tag = "KaizaxPage",
		})
		Animation.fade(divider, 0, {
			Duration = exit.Duration,
			Easing = exit.Easing,
			Direction = exit.Direction,
			Tag = "KaizaxPage",
		})
		Animation.fade(empty, 0, {
			Duration = exit.Duration,
			Easing = exit.Easing,
			Direction = exit.Direction,
			Tag = "KaizaxPage",
		})
		for _, section in sections do
			Animation.fade(section.Instance, 0, {
				Duration = exit.Duration,
				Easing = exit.Easing,
				Direction = exit.Direction,
				Tag = "KaizaxPage",
			})
		end
		Animation.play(body, exit.Duration, {
			Position = UDim2.fromOffset(0, finalBodyPosition.Y.Offset + 8),
		}, { easing = exit.Easing, direction = exit.Direction, tag = "KaizaxPage" })

		task.delay(exit.Duration + 0.02, function()
			if generation == transitionId then
				root.Visible = false
				restorePage()
				transitionState = "idle"
			end
		end)
	end

	function tab:SetVisible(visible: boolean)
		if visible then
			playEnter(true)
		else
			playExit(true)
		end
	end

	function tab:PlayIntro(animate: boolean?)
		playEnter(animate)
	end

	function tab:StopTransition()
		stopPageMotion()
		transitionState = "idle"
	end

	function tab:_ApplySearch(query: string): boolean
		local trimmed = string.gsub(query or "", "^%s*(.-)%s*$", "%1")
		local lowered = string.lower(trimmed)
		local firstMatch: any = nil
		local anyMatch = false

		for _, subtab in subtabs do
			local count = subtab:_ApplySearch(lowered)
			local matches = lowered == "" or count > 0
			local entry = buttons[subtab]

			if entry then
				entry.button.Visible = matches
			end

			if matches then
				anyMatch = true
				if not firstMatch then
					firstMatch = subtab
				end
			end
		end

		if lowered == "" then
			empty.Visible = false
			if current then
				current:_SetActive(true)
			end
			return true
		end

		if not anyMatch then
			empty.Text = `No controls match "{trimmed}".`
			empty.Visible = true
			for _, subtab in subtabs do
				subtab:_SetActive(false)
			end
			return false
		end

		empty.Visible = false
		if not current or current:_GetMatchCount() == 0 then
			selectSubTab(firstMatch)
		else
			current:_SetActive(true)
		end
		return true
	end

	function tab:_GetRoot(): Frame
		return root
	end

	function tab:Destroy()
		for _, subtab in subtabs do
			subtab:Destroy()
		end
		table.clear(subtabs)
		table.clear(buttons)
		root:Destroy()
	end

	return tab
end

return Tab
	end

