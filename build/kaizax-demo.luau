	__modules["Animation"] = function()
--!strict

local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

-- Master switches. Animation.play applies final values immediately when off.
local Animation = {}

Animation.ANIMATIONS_ENABLED = true
Animation.INTRO_ENABLED = true
Animation.GLOW_ENABLED = true
Animation.GLOW_PULSE = true

local EASING: { [string]: EasingStyle } = {
	Linear = Enum.EasingStyle.Linear,
	Sine = Enum.EasingStyle.Sine,
	Quad = Enum.EasingStyle.Quad,
	Cubic = Enum.EasingStyle.Cubic,
	Quart = Enum.EasingStyle.Quart,
	Quint = Enum.EasingStyle.Quint,
	Exponential = Enum.EasingStyle.Exponential,
	Back = Enum.EasingStyle.Back,
}

local DIRECTION: { [string]: EasingDirection } = {
	In = Enum.EasingDirection.In,
	Out = Enum.EasingDirection.Out,
	InOut = Enum.EasingDirection.InOut,
}

Animation.MOTION = {
	Enter = { Duration = 0.4, Easing = "Quint", Direction = "Out" },
	Exit = { Duration = 0.18, Easing = "Quad", Direction = "In" },
	Hover = { Duration = 0.13, Easing = "Quad", Direction = "Out" },
	Press = { Duration = 0.12, Easing = "Quad", Direction = "Out" },
	Indicator = { Duration = 0.3, Easing = "Exponential", Direction = "Out" },
	Label = { Duration = 0.15, Easing = "Quad", Direction = "Out" },
	Status = { Duration = 0.25, Easing = "Quad", Direction = "Out" },
	Stagger = 0.05,
}

export type PlayOptions = {
	easing: string?,
	direction: string?,
	delay: number?,
	repeatCount: number?,
	reverses: boolean?,
	tag: string?,
}

export type FadeOptions = {
	Duration: number?,
	Easing: string?,
	Direction: string?,
	Delay: number?,
	IncludeDescendants: boolean?,
	Tag: string?,
}

local FADE_PROPERTIES = {
	"BackgroundTransparency",
	"TextTransparency",
	"ImageTransparency",
	"Transparency",
}

local ORIGINAL_ATTRIBUTE = "KaizaxOriginal_"
local tracked: { [Instance]: { [string]: Tween } } = {}
local tags: { [Tween]: string? } = {}

local function reducedMotion(): boolean
	local ok, enabled = pcall(function()
		return GuiService.ReducedMotionEnabled
	end)
	return ok and enabled == true
end

local function forgetTween(tween: Tween)
	tags[tween] = nil
	for _, properties in tracked do
		for property, active in properties do
			if active == tween then
				properties[property] = nil
			end
		end
	end
end

--- Returns 0 when motion is disabled or the player requested reduced motion.
function Animation.duration(seconds: number): number
	if not Animation.ANIMATIONS_ENABLED or reducedMotion() then
		return 0
	end
	return math.max(0, seconds)
end

function Animation.enabled(): boolean
	return Animation.ANIMATIONS_ENABLED
end

function Animation.introEnabled(): boolean
	return Animation.ANIMATIONS_ENABLED and Animation.INTRO_ENABLED
end

--- Applies tween properties directly, without creating a tween.
function Animation.apply(instance: Instance, properties: { [string]: any })
	local target = instance :: any
	for property, value in properties do
		target[property] = value
	end
end

--- Rounds UDim offsets to integers so finished layouts stay crisp.
function Animation.integer(value: UDim2): UDim2
	return UDim2.new(
		value.X.Scale,
		math.floor(value.X.Offset + 0.5),
		value.Y.Scale,
		math.floor(value.Y.Offset + 0.5)
	)
end

--- Cancels tracked tweens on an instance, or one property of an instance.
function Animation.stop(instance: Instance, property: string?)
	local properties = tracked[instance]
	if not properties then
		return
	end

	if property then
		local tween = properties[property]
		if tween then
			Animation.cancel(tween)
		end
		return
	end

	for _, tween in properties do
		Animation.cancel(tween)
	end
end

--- Cancels every tracked tween under a root subtree.
function Animation.stopSubtree(root: Instance)
	local tweens: { Tween } = {}
	for instance, properties in tracked do
		if instance == root or instance:IsDescendantOf(root) then
			for _, tween in properties do
				tweens[#tweens + 1] = tween
			end
		end
	end
	for _, tween in tweens do
		Animation.cancel(tween)
	end
end

--- Cancels tracked tweens with a tag under a root subtree.
function Animation.stopTagged(root: Instance, tag: string)
	for instance, properties in tracked do
		if instance == root or instance:IsDescendantOf(root) then
			for _, tween in properties do
				if tags[tween] == tag then
					Animation.cancel(tween)
				end
			end
		end
	end
end

--- Tweens an instance and returns the tween, or nil when motion is disabled.
--- Active tweens are stored per object and property; a new tween replaces the old.
function Animation.play(
	instance: Instance,
	seconds: number,
	properties: { [string]: any },
	options: PlayOptions?
): Tween?
	local opts = (options or {}) :: PlayOptions
	local duration = Animation.duration(seconds)

	if duration <= 0 then
		for property in properties do
			Animation.stop(instance, property)
		end
		Animation.apply(instance, properties)
		return nil
	end

	for property in properties do
		Animation.stop(instance, property)
	end

	local info = TweenInfo.new(
		duration,
		EASING[opts.easing or "Quad"] or Enum.EasingStyle.Quad,
		DIRECTION[opts.direction or "Out"] or Enum.EasingDirection.Out,
		opts.repeatCount or 0,
		opts.reverses or false,
		opts.delay or 0
	)

	local tween = TweenService:Create(instance, info, properties)
	local own = tracked[instance]
	if not own then
		own = {}
		tracked[instance] = own
	end
	for property in properties do
		own[property] = tween
	end
	tags[tween] = opts.tag

	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and (opts.repeatCount or 0) == 0 then
			Animation.apply(instance, properties)
		end
		forgetTween(tween)
	end)

	tween:Play()
	return tween
end

--- Cancels a tween if it is still running.
function Animation.cancel(tween: Tween?)
	if tween and tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween:Cancel()
	end
	if tween then
		forgetTween(tween)
	end
end

function Animation.setOriginal(instance: Instance, property: string, value: number)
	instance:SetAttribute(ORIGINAL_ATTRIBUTE .. property, value)
end

--- Stores current transparencies before anything is hidden or faded.
function Animation.captureSubtree(root: Instance)
	local targets: { Instance } = { root }
	for _, descendant in root:GetDescendants() do
		targets[#targets + 1] = descendant
	end

	for _, instance in targets do
		local isStroke = instance:IsA("UIStroke")
		local isGui = instance:IsA("GuiObject")
		if not isStroke and not isGui then
			continue
		end
		for _, property in FADE_PROPERTIES do
			if property == "Transparency" and not isStroke then
				continue
			end
			if property ~= "Transparency" and not isGui then
				continue
			end
			if typeof(instance:GetAttribute(ORIGINAL_ATTRIBUTE .. property)) == "number" then
				continue
			end
			local ok, value = pcall(function()
				return (instance :: any)[property]
			end)
			if ok and typeof(value) == "number" then
				instance:SetAttribute(ORIGINAL_ATTRIBUTE .. property, value)
			end
		end
	end
end

local function originalTransparency(instance: Instance, property: string): number?
	local key = ORIGINAL_ATTRIBUTE .. property
	local stored = instance:GetAttribute(key)
	if typeof(stored) == "number" then
		return stored
	end

	local ok, value = pcall(function()
		return (instance :: any)[property]
	end)
	if not ok or typeof(value) ~= "number" then
		return nil
	end

	instance:SetAttribute(key, value)
	return value
end

--- Fades a subtree while preserving each object's original transparency.
--- alpha 1 restores originals; alpha 0 hides them.
function Animation.fade(root: Instance, alpha: number, options: FadeOptions?)
	local opts = (options or {}) :: FadeOptions
	local motion = Animation.MOTION.Enter
	local duration = Animation.duration(opts.Duration or motion.Duration)
	local fraction = math.clamp(alpha, 0, 1)
	local targets: { Instance } = { root }
	if opts.IncludeDescendants ~= false then
		for _, descendant in root:GetDescendants() do
			targets[#targets + 1] = descendant
		end
	end

	for _, instance in targets do
		local isStroke = instance:IsA("UIStroke")
		local isGui = instance:IsA("GuiObject")
		if isStroke or isGui then
			for _, property in FADE_PROPERTIES do
				if property == "Transparency" and not isStroke then
					continue
				end
				if property ~= "Transparency" and not isGui then
					continue
				end

				local original = originalTransparency(instance, property)
				if original then
					local target = if fraction >= 1
						then original
						else original + (1 - original) * (1 - fraction)
					Animation.play(instance, duration, {
						[property] = target,
					}, {
						easing = opts.Easing or motion.Easing,
						direction = opts.Direction or motion.Direction,
						delay = opts.Delay or 0,
						tag = opts.Tag,
					})
				end
			end
		end

		if instance:IsA("CanvasGroup") then
			local visible = if fraction >= 1 then 0 else 1 - fraction
			Animation.play(instance, duration, {
				GroupTransparency = visible,
			}, {
				easing = opts.Easing or motion.Easing,
				direction = opts.Direction or motion.Direction,
				delay = opts.Delay or 0,
				tag = opts.Tag,
			})
		end
	end
end

function Animation.reducedMotion(): boolean
	return reducedMotion()
end

return Animation
	end

	__modules["Components/Base"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")

local Base = {}

export type TextOptions = {
	Font: Enum.Font?,
	Size: number?,
	ColorRole: string?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Wrapped: boolean?,
	Truncate: boolean?,
}

--- Creates a styled, theme-bound text label.
function Base.text(
	ctx: Types.UIContext,
	parent: Instance,
	text: string,
	options: TextOptions?
): TextLabel
	local theme = ctx.GetTheme()
	local opts = options or {}

	local label = Util.label({
		BackgroundTransparency = 1,
		Text = text,
		Font = opts.Font or theme.Fonts.Regular,
		TextSize = opts.Size or 13,
		TextColor3 = theme.Palette.TextMuted,
		TextXAlignment = opts.XAlign or Enum.TextXAlignment.Left,
		TextYAlignment = opts.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = opts.Wrapped or false,
		TextTruncate = if opts.Wrapped then Enum.TextTruncate.None elseif opts.Truncate == false then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd,
		RichText = false,
		Size = UDim2.fromScale(1, 1),
	}, parent)

	ctx.Paint(label, "TextColor3", opts.ColorRole or "TextMuted")
	return label
end

--- Standard control row with a label and an optional right-hand slot.
function Base.row(
	ctx: Types.UIContext,
	parent: Instance,
	text: string?,
	height: number?
): (Frame, Frame, TextLabel?)
	local theme = ctx.GetTheme()
	local rowHeight = height or theme.Window.RowHeight

	local row = Util.frame({
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, rowHeight),
	}, parent)

	local label: TextLabel? = nil
	if text and text ~= "" then
		label = Base.text(ctx, row, text, {
			Font = theme.Fonts.Medium,
			Size = 13,
			ColorRole = "TextMuted",
		})
		label.Size = UDim2.new(1, -200, 1, 0)
	end

	local slot = Util.frame({
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(0, rowHeight),
		AutomaticSize = Enum.AutomaticSize.X,
	}, row)

	Util.create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, slot)

	return row, slot, label
end

--- Hover/press color behavior with theme bindings kept in sync.
function Base.hover(
	ctx: Types.UIContext,
	object: GuiObject,
	bag: Util.Bag,
	baseRole: string?,
	hoverRole: string?,
	baseTransparency: number?,
	hoverTransparency: number?
)
	local theme = ctx.GetTheme()
	local hover = hoverRole or "Hover"
	local normalTransparency = baseTransparency or 0
	local activeTransparency = hoverTransparency or normalTransparency

	if baseRole then
		ctx.Paint(object, "BackgroundColor3", baseRole)
	else
		object.BackgroundTransparency = normalTransparency
	end

	bag:Add(object.MouseEnter:Connect(function()
		if baseRole then
			ctx.Paint(object, "BackgroundColor3", hover)
		end
		Animation.play(object, theme.Motion.Fast, {
			BackgroundColor3 = ctx.Color(hover),
			BackgroundTransparency = activeTransparency,
		}, {
			easing = "Quad",
		})
	end))

	bag:Add(object.MouseLeave:Connect(function()
		if baseRole then
			ctx.Paint(object, "BackgroundColor3", baseRole)
		end
		Animation.play(object, theme.Motion.Fast, {
			BackgroundColor3 = if baseRole then ctx.Color(baseRole) else ctx.Color(hover),
			BackgroundTransparency = normalTransparency,
		}, {
			easing = "Quad",
		})
	end))
end

--- Adds a press-scale to a button without affecting layout.
function Base.pressable(object: GuiObject, bag: Util.Bag)
	local scale = Util.create("UIScale", {
		Scale = 1,
	}, object) :: UIScale

	bag:Add(object.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			Animation.play(scale, 0.08, { Scale = 0.97 }, { easing = "Quad" })
		end
	end))

	local function release()
		Animation.play(scale, 0.14, { Scale = 1 }, { easing = "Quad", direction = "Out" })
	end

	bag:Add(object.InputEnded:Connect(release))
	bag:Add(object.MouseLeave:Connect(release))
	return scale
end

function Base.spacer(parent: Instance, height: number): Frame
	return Util.frame({
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
	}, parent)
end

--- Small chevron made from primitives so it stays crisp at any scale.
function Base.chevron(ctx: Types.UIContext, parent: Instance, colorRole: string?): Frame
	local holder = Util.frame({
		Name = "Chevron",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(14, 14),
	}, parent)

	local left = Util.frame({
		Name = "Left",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(4.4, 5.4),
		Rotation = 45,
		Size = UDim2.fromOffset(7.5, 2),
	}, holder)
	Util.corner(left, 1)
	ctx.Paint(left, "BackgroundColor3", colorRole or "TextFaint")

	local right = Util.frame({
		Name = "Right",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(9.6, 5.4),
		Rotation = -45,
		Size = UDim2.fromOffset(7.5, 2),
	}, holder)
	Util.corner(right, 1)
	ctx.Paint(right, "BackgroundColor3", colorRole or "TextFaint")

	return holder
end

return Base
	end

	__modules["Components/Button"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local Button = {}
Button.__index = Button

export type Options = {
	Text: string?,
	Variant: Types.ButtonVariant?,
	Height: number?,
	Disabled: boolean?,
	Callback: (() -> ())?,
}

export type Button = {
	Instance: TextButton,
	Clicked: Signal.Signal,
	SetText: (self: Button, text: string) -> (),
	GetText: (self: Button) -> string,
	SetDisabled: (self: Button, disabled: boolean) -> (),
	GetDisabled: (self: Button) -> boolean,
	SetVisible: (self: Button, visible: boolean) -> (),
	Sweep: (self: Button, enabled: boolean) -> (),
	Flash: (self: Button) -> (),
	OnClicked: (self: Button, handler: () -> ()) -> Signal.Connection,
	Destroy: (self: Button) -> (),
}

local registry: { [Instance]: Button } = {}

function Button.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Button
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local variant = options.Variant or "Secondary"
	local text = options.Text or "Button"
	local disabled = options.Disabled == true
	local callback = options.Callback

	local instance = Util.textButton({
		Name = "Button",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, options.Height or 32),
		Text = "",
		Active = not disabled,
	}, parent)
	instance:SetAttribute("KaizaxButtonVariant", variant)

	local surface = Util.frame({
		Name = "Surface",
		BackgroundColor3 = theme.Palette.SurfaceRaised,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
	}, instance)
	Util.corner(surface, theme.Radius.Element)
	if variant == "Primary" then
		Util.gradient(surface, "PrimaryShade", 0, theme)
	end

	local label = Base.text(ctx, instance, text, {
		Font = theme.Fonts.Medium,
		Size = 13,
		ColorRole = "Text",
		XAlign = Enum.TextXAlignment.Center,
	})
	label.Size = UDim2.new(1, -20, 1, 0)
	label.Position = UDim2.fromOffset(10, 0)
	label.ZIndex = 3

	local sweep = Util.frame({
		Name = "Sweep",
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 2,
	}, surface)
	ctx.Paint(sweep, "BackgroundColor3", "Text")
	local sweepGradient = Util.create("UIGradient", {
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, sweep) :: UIGradient
	local sweepTween: Tween? = nil
	local sweepToken = 0

	local stroke = Util.stroke(surface, 1)
	stroke.Transparency = 1
	local clicked = Signal.new()

	local function stopSweep()
		sweepToken += 1
		Animation.cancel(sweepTween)
		sweepTween = nil
		sweep.Visible = false
		sweepGradient.Offset = Vector2.new(-1, 0)
	end

	bag:Add(instance:GetPropertyChangedSignal("Visible"):Connect(function()
		if not instance.Visible then
			stopSweep()
		end
	end))

	local function startSweep(loop: boolean)
		stopSweep()
		if not Animation.enabled() or Animation.reducedMotion() then
			return
		end

		local token = sweepToken
		sweep.Visible = true
		sweepGradient.Offset = Vector2.new(-1, 0)
		sweepTween = Animation.play(sweepGradient, if loop then 0.7 else 0.45, {
			Offset = Vector2.new(1, 0),
		}, {
			easing = "Quad",
			repeatCount = if loop then -1 else 0,
			tag = "KaizaxSweep",
		})

		if not loop then
			task.delay(0.47, function()
				if token == sweepToken then
					sweep.Visible = false
				end
			end)
		end
	end

	local function style(): (Color3, number, string, string, Color3?, number?, string?)
		local current = ctx.GetTheme()

		if disabled then
			return current.Palette.SurfaceRaised, 0.45, "SurfaceRaised", "TextFaint", nil, nil, "SurfaceRaised"
		end

		if variant == "Primary" then
			return current.Palette.Accent, 0, "Accent", "OnAccent", nil, nil, "Accent"
		elseif variant == "Danger" then
			return current.Palette.Danger, 0.9, "Danger", "Danger", current.Palette.Danger, 0.65, "Danger"
		elseif variant == "Ghost" then
			return current.Palette.Surface, 0.35, "Surface", "TextMuted", current.Palette.Stroke, 0.35, "Stroke"
		end

		return current.Palette.SurfaceRaised, 0, "SurfaceRaised", "Text", current.Palette.Stroke, 0, "Stroke"
	end

	local function applyStyle(animate: boolean)
		local background, transparency, backgroundRole, textRole, strokeColor, strokeTransparency, strokeRole =
			style()

		local strokeRoleName = strokeRole or "Stroke"
		if animate then
			Util.paint(surface, "BackgroundColor3", backgroundRole)
			Util.paint(label, "TextColor3", textRole)
			if strokeColor then
				Util.paint(stroke, "Color", strokeRoleName)
			end
		else
			ctx.Paint(surface, "BackgroundColor3", backgroundRole)
			ctx.Paint(label, "TextColor3", textRole)
			if strokeColor then
				ctx.Paint(stroke, "Color", strokeRoleName)
			end
		end

		stroke.Transparency = if strokeColor then (strokeTransparency or 0) else 1

		if animate then
			local motion = Animation.MOTION.Hover
			Animation.play(surface, motion.Duration, {
				BackgroundColor3 = background,
				BackgroundTransparency = transparency,
			}, {
				easing = motion.Easing,
				direction = motion.Direction,
			})

			if not disabled then
				Animation.play(label, Animation.MOTION.Label.Duration, {
					TextColor3 = ctx.Color(textRole),
				}, {
					easing = Animation.MOTION.Label.Easing,
					direction = Animation.MOTION.Label.Direction,
				})
			end
		else
			surface.BackgroundColor3 = background
			surface.BackgroundTransparency = transparency
			label.TextColor3 = ctx.Color(textRole)
		end
	end

	applyStyle(false)

	local pressed = false
	local function setPressed(value: boolean)
		if disabled or pressed == value then
			return
		end
		pressed = value

		local current = ctx.GetTheme()
		local background, _, backgroundRole = style()
		Util.paint(surface, "BackgroundColor3", backgroundRole)
		local target = if value then background:Lerp(current.Palette.Background, 0.18) else background
		local motion = Animation.MOTION.Press

		Animation.play(surface, motion.Duration, {
			BackgroundColor3 = target,
		}, { easing = motion.Easing, direction = motion.Direction })
		Animation.play(label, motion.Duration, {
			Position = UDim2.fromOffset(10, if value then 1 else 0),
		}, { easing = motion.Easing, direction = motion.Direction })
	end

	bag:Add(instance.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			setPressed(true)
		end
	end))

	local function releasePress()
		setPressed(false)
	end

	bag:Add(instance.InputEnded:Connect(releasePress))
	bag:Add(instance.MouseLeave:Connect(releasePress))

	bag:Add(instance.MouseEnter:Connect(function()
		if disabled then
			return
		end

		local current = ctx.GetTheme()
		local motion = Animation.MOTION.Hover
		local hoverColor: Color3
		local hoverTransparency: number
		local hoverRole: string

		if variant == "Primary" then
			hoverColor = current.Palette.Accent:Lerp(current.Palette.Text, 0.08)
			hoverTransparency = 0
			hoverRole = "Accent"
		elseif variant == "Danger" then
			hoverColor = current.Palette.Danger
			hoverTransparency = 0.82
			hoverRole = "Danger"
		else
			hoverColor = current.Palette.Hover
			hoverTransparency = 0
			hoverRole = "Hover"
		end

		Util.paint(surface, "BackgroundColor3", hoverRole)
		Animation.play(surface, motion.Duration, {
			BackgroundColor3 = hoverColor,
			BackgroundTransparency = hoverTransparency,
		}, {
			easing = motion.Easing,
			direction = motion.Direction,
		})

		if variant == "Ghost" then
			Util.paint(label, "TextColor3", "Text")
			Animation.play(label, Animation.MOTION.Label.Duration, {
				TextColor3 = current.Palette.Text,
			}, {
				easing = Animation.MOTION.Label.Easing,
				direction = Animation.MOTION.Label.Direction,
			})
		end

		if stroke.Transparency < 1 then
			Util.paint(stroke, "Color", "StrokeStrong")
			Animation.play(stroke, motion.Duration, {
				Color = current.Palette.StrokeStrong,
			}, {
				easing = motion.Easing,
				direction = motion.Direction,
			})
		end
	end))

	bag:Add(instance.MouseLeave:Connect(function()
		if disabled then
			return
		end
		applyStyle(true)
	end))

	bag:Add(instance.Activated:Connect(function()
		if disabled then
			return
		end
		clicked:Fire()
		Util.safeCall(callback)
	end))

	local self = setmetatable({} :: any, Button) :: Button
	self.Instance = instance
	self.Clicked = clicked
	registry[instance] = self

	function self:SetText(newText: string)
		text = newText
		label.Text = newText
	end

	function self:GetText(): string
		return text
	end

	function self:SetDisabled(value: boolean)
		if disabled == value then
			return
		end
		disabled = value
		instance.Active = not value
		if value then
			stopSweep()
			setPressed(false)
		end
		applyStyle(true)
	end

	function self:GetDisabled(): boolean
		return disabled
	end

	function self:SetVisible(visible: boolean)
		instance.Visible = visible
	end

	function self:Sweep(enabled: boolean)
		if enabled then
			startSweep(true)
		else
			stopSweep()
		end
	end

	function self:Flash()
		startSweep(false)
	end

	function self:OnClicked(handler: () -> ()): Signal.Connection
		return clicked:Connect(handler)
	end

	function self:Destroy()
		stopSweep()
		registry[instance] = nil
		bag:Clear()
		clicked:DisconnectAll()
		instance:Destroy()
	end

	instance:SetAttribute("KaizaxComponent", "Button")
	ctx.Register(instance, text)

	return self
end

function Button.Get(instance: Instance): Button?
	return registry[instance]
end

return Button
	end

	__modules["Components/Checkbox"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local Checkbox = {}
Checkbox.__index = Checkbox

export type Options = {
	Text: string?,
	Default: boolean?,
	Disabled: boolean?,
	Callback: ((value: boolean) -> ())?,
}

export type Checkbox = {
	Instance: Frame,
	Changed: Signal.Signal,
	GetValue: (self: Checkbox) -> boolean,
	SetValue: (self: Checkbox, value: boolean, silent: boolean?) -> (),
	Toggle: (self: Checkbox, silent: boolean?) -> (),
	SetDisabled: (self: Checkbox, disabled: boolean) -> (),
	SetVisible: (self: Checkbox, visible: boolean) -> (),
	OnChanged: (self: Checkbox, handler: (value: boolean) -> ()) -> Signal.Connection,
	Destroy: (self: Checkbox) -> (),
}

function Checkbox.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Checkbox
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local value = options.Default == true
	local disabled = options.Disabled == true
	local hovered = false
	local callback = options.Callback
	local labelText = options.Text or "Checkbox"

	local row = Base.row(ctx, parent, labelText)
	local changed = Signal.new()

	local box = Util.textButton({
		Name = "Checkbox",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(20, 20),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Active = not disabled,
	}, row)

	Util.corner(box, theme.Radius.Element - 4)
	local stroke = Util.stroke(box, 1)

	local check = Util.frame({
		Name = "Check",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
	}, box)

	local short = Util.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(7, 11),
		Size = UDim2.fromOffset(2, 7),
		Rotation = 45,
		BorderSizePixel = 0,
	}, check)
	Util.corner(short, 1)

	local long = Util.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(11, 10),
		Size = UDim2.fromOffset(2, 10),
		Rotation = -48,
		BorderSizePixel = 0,
	}, check)
	Util.corner(long, 1)

	local checkScale = Util.create("UIScale", {
		Scale = if value then 1 else 0,
	}, check) :: UIScale

	local function targets(): (Color3, string, Color3, number, number)
		local current = ctx.GetTheme()

		if disabled then
			return current.Palette.SurfaceRaised, "SurfaceRaised", current.Palette.TextFaint, 0.5, 0.7
		end

		if value then
			return current.Palette.Accent, "Accent", current.Palette.OnAccent, 0, 1
		end

		if hovered then
			return current.Palette.Hover, "Hover", current.Palette.Text, 0, 0.55
		end

		return current.Palette.SurfaceRaised, "SurfaceRaised", current.Palette.TextFaint, 0, 0.4
	end

	local function apply(animate: boolean)
		local fill, fillRole, mark, strokeTransparency, strokeOpacity = targets()
		local current = ctx.GetTheme()

		ctx.Paint(box, "BackgroundColor3", fillRole)
		ctx.Paint(stroke, "Color", if value then "Accent" else if hovered then "StrokeStrong" else "Stroke")
		ctx.Paint(short, "BackgroundColor3", if value then "OnAccent" else "TextFaint")
		ctx.Paint(long, "BackgroundColor3", if value then "OnAccent" else "TextFaint")

		local targetScale = if value then 1 else 0

		if animate then
			Animation.play(box, current.Motion.Fast, {
				BackgroundColor3 = fill,
			}, {
				easing = "Quad",
			})
			Animation.play(checkScale, current.Motion.Fast, {
				Scale = targetScale,
			}, {
				easing = "Quad",
				direction = "Out",
			})
			stroke.Transparency = strokeTransparency
			Animation.play(stroke, current.Motion.Fast, {
				Transparency = strokeTransparency,
			}, {
				easing = "Quad",
			})
		else
			box.BackgroundColor3 = fill
			checkScale.Scale = targetScale
			stroke.Transparency = strokeTransparency
		end

		short.BackgroundColor3 = if value then ctx.Color("OnAccent") else ctx.Color("TextFaint")
		long.BackgroundColor3 = short.BackgroundColor3
	end

	local function setValue(nextValue: boolean, silent: boolean?)
		if value == nextValue or disabled then
			return
		end
		value = nextValue
		apply(true)
		changed:Fire(value)
		if not silent then
			Util.safeCall(callback, value)
		end
	end

	apply(false)

	bag:Add(box.Activated:Connect(function()
		setValue(not value, false)
	end))

	bag:Add(box.MouseEnter:Connect(function()
		if disabled then
			return
		end
		hovered = true
		apply(true)
	end))

	bag:Add(box.MouseLeave:Connect(function()
		if disabled then
			return
		end
		hovered = false
		apply(true)
	end))

	local self = setmetatable({} :: any, Checkbox) :: Checkbox
	self.Instance = row
	self.Changed = changed

	function self:GetValue(): boolean
		return value
	end

	function self:SetValue(nextValue: boolean, silent: boolean?)
		setValue(nextValue, silent)
	end

	function self:Toggle(silent: boolean?)
		setValue(not value, silent)
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		box.Active = not disabled
		apply(true)
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (value: boolean) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:Destroy()
		bag:Clear()
		changed:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "Checkbox")
	ctx.Register(row, labelText)

	return self
end

return Checkbox
	end

	__modules["Components/ColorPicker"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local UserInputService = game:GetService("UserInputService")

local ColorPicker = {}
ColorPicker.__index = ColorPicker

export type Options = {
	Text: string?,
	Default: Color3?,
	Alpha: number?,
	ShowAlpha: boolean?,
	Live: boolean?,
	Disabled: boolean?,
	Callback: ((color: Color3, alpha: number) -> ())?,
}

export type ColorPicker = {
	Instance: Frame,
	Changed: Signal.Signal,
	Released: Signal.Signal,
	GetColor: (self: ColorPicker) -> Color3,
	GetAlpha: (self: ColorPicker) -> number,
	SetValue: (self: ColorPicker, color: Color3, alpha: number?, silent: boolean?) -> (),
	SetDisabled: (self: ColorPicker, disabled: boolean) -> (),
	SetVisible: (self: ColorPicker, visible: boolean) -> (),
	OnChanged: (self: ColorPicker, handler: (color: Color3, alpha: number) -> ()) -> Signal.Connection,
	OnReleased: (self: ColorPicker, handler: (color: Color3, alpha: number) -> ()) -> Signal.Connection,
	Destroy: (self: ColorPicker) -> (),
}

local function clamp01(value: number): number
	return math.clamp(value, 0, 1)
end

local function parseHex(value: string): Color3?
	local cleaned = string.gsub(value, "%s", "")
	cleaned = string.gsub(cleaned, "#", "")
	if #cleaned == 3 then
		cleaned = string.sub(cleaned, 1, 1) .. string.sub(cleaned, 1, 1)
			.. string.sub(cleaned, 2, 2) .. string.sub(cleaned, 2, 2)
			.. string.sub(cleaned, 3, 3) .. string.sub(cleaned, 3, 3)
	end
	if #cleaned ~= 6 or string.find(cleaned, "[^%x]") then
		return nil
	end
	local ok, color = pcall(Color3.fromHex, "#" .. cleaned)
	return if ok then color else nil
end

function ColorPicker.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): ColorPicker
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local popupBag = Util.bag()
	local labelText = options.Text or "Color"
	local showAlpha = options.ShowAlpha ~= false
	local live = options.Live ~= false
	local disabled = options.Disabled == true
	local callback = options.Callback
	local initialColor = options.Default or Color3.fromHex("#00FAB4")
	local color = initialColor
	local alpha = clamp01(options.Alpha or 1)
	local hue, saturation, value = color:ToHSV()
	local owner = {}
	local popupOpen = false
	local closeActive: (() -> ())? = nil
	local changed = Signal.new()
	local released = Signal.new()

	local row, _, rowLabel = Base.row(ctx, parent, labelText)
	if rowLabel then
		rowLabel.Size = UDim2.new(1, -132, 1, 0)
	end

	local hexLabel = Base.text(ctx, row, Util.hex(color), {
		Font = theme.Fonts.Mono,
		Size = 10,
		ColorRole = "TextMuted",
		XAlign = Enum.TextXAlignment.Right,
	})
	hexLabel.AnchorPoint = Vector2.new(1, 0.5)
	hexLabel.Position = UDim2.new(1, -40, 0.5, 0)
	hexLabel.Size = UDim2.fromOffset(72, 20)

	local swatch = Util.textButton({
		Name = "Swatch",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(32, 24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Active = not disabled,
		ClipsDescendants = true,
	}, row)

	Util.corner(swatch, theme.Radius.Element - 2)
	local swatchStroke = Util.stroke(swatch, 1)
	ctx.Paint(swatchStroke, "Color", "StrokeStrong")

	local swatchCell = 6
	for y = 0, 3 do
		for x = 0, 4 do
			local tile = Util.frame({
				BackgroundColor3 = theme.Palette.Surface,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(x * swatchCell, y * swatchCell),
				Size = UDim2.fromOffset(swatchCell, swatchCell),
			}, swatch)
			ctx.Paint(tile, "BackgroundColor3", if (x + y) % 2 == 0 then "Surface" else "Hover")
		end
	end

	local swatchColor = Util.frame({
		Name = "Color",
		BackgroundColor3 = color,
		BackgroundTransparency = 1 - alpha,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	}, swatch)
	Util.corner(swatchColor, theme.Radius.Element - 3)

	local function refreshRow()
		hexLabel.Text = Util.hex(color)
		swatchColor.BackgroundColor3 = color
		swatchColor.BackgroundTransparency = 1 - alpha
	end

	local function notify(fromUser: boolean, releasedNow: boolean)
		changed:Fire(color, alpha)
		if fromUser and (live or releasedNow) then
			Util.safeCall(callback, color, alpha)
		end
		if releasedNow then
			released:Fire(color, alpha)
		end
	end

	refreshRow()

	local function close()
		if closeActive then
			local callbackClose = closeActive
			closeActive = nil
			callbackClose()
		end
	end

	local function makeChecker(parentFrame: Instance, width: number, height: number, cell: number): Frame
		local holder = Util.frame({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(width, height),
			ClipsDescendants = true,
		}, parentFrame)

		local columns = math.ceil(width / cell)
		local rows = math.ceil(height / cell)
		for y = 0, rows - 1 do
			for x = 0, columns - 1 do
				local tile = Util.frame({
					BackgroundColor3 = theme.Palette.Surface,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(x * cell, y * cell),
					Size = UDim2.fromOffset(cell, cell),
				}, holder)
				ctx.Paint(tile, "BackgroundColor3", if (x + y) % 2 == 0 then "SurfaceRaised" else "Hover")
			end
		end

		return holder
	end

	local function open()
		if disabled or popupOpen then
			return
		end

		close()
		popupBag:Clear()

		local contentHeight = if showAlpha then 290 else 272
		local popupFrame, closeFn = ctx.OpenPopup(owner, swatch, 232, contentHeight + 24, function()
			popupOpen = false
			closeActive = nil
			popupBag:Clear()
		end)

		popupOpen = true
		closeActive = closeFn
		local activeDrag: string? = nil

		local content = Util.frame({
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(208, contentHeight),
		}, popupFrame)

		local header = Base.text(ctx, content, "Color", {
			Font = theme.Fonts.Medium,
			Size = 12,
			ColorRole = "Text",
		})
		header.Position = UDim2.fromOffset(0, 0)
		header.Size = UDim2.new(1, 0, 0, 16)

		local readout = Base.text(ctx, content, "", {
			Font = theme.Fonts.Mono,
			Size = 10,
			ColorRole = "TextMuted",
			XAlign = Enum.TextXAlignment.Right,
		})
		readout.Position = UDim2.fromOffset(0, 0)
		readout.Size = UDim2.new(1, 0, 0, 16)

		local svY = 24
		local svSize = Vector2.new(208, 112)
		local svContainer = Util.frame({
			Name = "SaturationValue",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, svY),
			Size = UDim2.fromOffset(svSize.X, svSize.Y),
		}, content)

		local svSquare = Util.frame({
			BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ClipsDescendants = true,
		}, svContainer)
		Util.corner(svSquare, theme.Radius.Element - 2)

		local whiteOverlay = Util.frame({
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
		}, svSquare)

		Util.create("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, whiteOverlay)

		local darkOverlay = Util.frame({
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
		}, svSquare)

		Util.create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.new(0, 0, 0)),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		}, darkOverlay)

		local svHit = Util.textButton({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			AutoButtonColor = false,
			ZIndex = 4,
		}, svContainer)

		local svRing = Util.frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(16, 16),
			ZIndex = 5,
		}, svContainer)
		Util.corner(svRing, 999)
		Util.create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.new(0, 0, 0),
			Thickness = 1,
			Transparency = 0.35,
		}, svRing)

		local svInner = Util.frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
		}, svRing)
		Util.create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.new(1, 1, 1),
			Thickness = 2,
		}, svInner)
		Util.corner(svInner, 999)

		local hueY = svY + svSize.Y + 10
		local stripWidth = 208
		local hueContainer = Util.frame({
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, hueY),
			Size = UDim2.fromOffset(stripWidth, 16),
		}, content)

		local hueStrip = Util.frame({
			BackgroundColor3 = Color3.new(1, 0, 0),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 2),
			Size = UDim2.fromOffset(stripWidth, 12),
			ClipsDescendants = true,
		}, hueContainer)
		Util.corner(hueStrip, 999)

		Util.create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
			}),
		}, hueStrip)

		local hueHit = Util.textButton({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Text = "",
			AutoButtonColor = false,
			ZIndex = 4,
		}, hueContainer)

		local hueMarker = Util.frame({
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Position = UDim2.new(hue, 0, 0.5, 0),
			Size = UDim2.fromOffset(3, 16),
			ZIndex = 5,
		}, hueContainer)
		Util.corner(hueMarker, theme.Radius.Element / 3)
		Util.create("UIStroke", {
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.new(0, 0, 0),
			Thickness = 1,
			Transparency = 0.4,
		}, hueMarker)

		local alphaY = hueY + 24
		local alphaContainer: Frame? = nil
		local alphaMarker: Frame? = nil
		local alphaFill: Frame? = nil
		local alphaHit: TextButton? = nil

		if showAlpha then
			alphaContainer = Util.frame({
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(0, alphaY),
				Size = UDim2.fromOffset(stripWidth, 16),
			}, content)

			local alphaChecker = makeChecker(alphaContainer, stripWidth, 10, 8)
			alphaChecker.Position = UDim2.fromOffset(0, 3)
			alphaChecker.ClipsDescendants = true
			Util.corner(alphaChecker, 999)

			alphaFill = Util.frame({
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, 3),
				Size = UDim2.fromOffset(stripWidth, 10),
				ClipsDescendants = true,
			}, alphaContainer)
			Util.corner(alphaFill, 999)

			Util.create("UIGradient", {
				Color = ColorSequence.new(color),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(1, 0),
				}),
			}, alphaFill)

			alphaHit = Util.textButton({
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				Text = "",
				AutoButtonColor = false,
				ZIndex = 4,
			}, alphaContainer)

			alphaMarker = Util.frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Position = UDim2.new(alpha, 0, 0.5, 0),
				Size = UDim2.fromOffset(3, 16),
				ZIndex = 5,
			}, alphaContainer)
			Util.corner(alphaMarker, theme.Radius.Element / 3)
			Util.create("UIStroke", {
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = Color3.new(0, 0, 0),
				Thickness = 1,
				Transparency = 0.4,
			}, alphaMarker)
		end

		local hexY = alphaY + (if showAlpha then 26 else 8)
		local hexBox = Util.textBox({
			Name = "Hex",
			BackgroundColor3 = ctx.Color("SurfaceRaised"),
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Font = theme.Fonts.Mono,
			PlaceholderText = "#00FAB4",
			PlaceholderColor3 = ctx.Color("TextFaint"),
			Position = UDim2.fromOffset(0, hexY),
			Size = UDim2.fromOffset(104, 28),
			Text = Util.hex(color),
			TextColor3 = ctx.Color("Text"),
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, content)
		Util.corner(hexBox, theme.Radius.Element - 2)
		Util.padding(hexBox, 9, 0)
		local hexStroke = Util.stroke(hexBox, 1)
		ctx.Paint(hexBox, "BackgroundColor3", "SurfaceRaised")
		ctx.Paint(hexBox, "TextColor3", "Text")
		ctx.Paint(hexBox, "PlaceholderColor3", "TextFaint")
		ctx.Paint(hexStroke, "Color", "Stroke")

		local alphaReadout = Base.text(ctx, content, "", {
			Font = theme.Fonts.Mono,
			Size = 10,
			ColorRole = "TextMuted",
			XAlign = Enum.TextXAlignment.Right,
		})
		alphaReadout.Position = UDim2.fromOffset(112, hexY)
		alphaReadout.Size = UDim2.fromOffset(96, 28)

		local previewY = hexY + 38
		local previewContainer = Util.frame({
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, previewY),
			Size = UDim2.fromOffset(208, 20),
		}, content)
		Util.corner(previewContainer, theme.Radius.Element - 2)

		local previewChecker = makeChecker(previewContainer, 208, 20, 5)
		previewChecker.Size = UDim2.fromScale(1, 1)
		Util.corner(previewChecker, theme.Radius.Element - 2)

		local previewFill = Util.frame({
			BackgroundColor3 = color,
			BackgroundTransparency = 1 - alpha,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
		}, previewContainer)
		Util.corner(previewFill, theme.Radius.Element - 2)

		local previewStroke = Util.stroke(previewContainer, 1)
		ctx.Paint(previewStroke, "Color", "Stroke")

		local footer = Util.frame({
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, previewY + 30),
			Size = UDim2.fromOffset(208, 26),
		}, content)

		Util.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, footer)

		local function footerButton(text: string, primary: boolean, order: number): TextButton
			local button = Util.textButton({
				BackgroundColor3 = ctx.Color(if primary then "Accent" else "SurfaceRaised"),
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(62, 26),
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = order,
			}, footer)
			Util.corner(button, theme.Radius.Element - 2)
			ctx.Paint(button, "BackgroundColor3", if primary then "Accent" else "SurfaceRaised")
			local label = Base.text(ctx, button, text, {
				Font = theme.Fonts.Medium,
				Size = 11,
				ColorRole = if primary then "OnAccent" else "TextMuted",
				XAlign = Enum.TextXAlignment.Center,
			})
			label.Size = UDim2.fromScale(1, 1)
			return button
		end

		local resetButton = footerButton("Reset", false, 1)
		local doneButton = footerButton("Done", true, 2)

		local function refreshPicker()
			local h, s, v = color:ToHSV()
			hue = h
			saturation = s
			value = v
			svSquare.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
			svRing.Position = UDim2.fromScale(saturation, 1 - value)
			hueMarker.Position = UDim2.new(hue, 0, 0.5, 0)
			hexBox.Text = Util.hex(color)
			readout.Text = `{string.upper(Util.hex(color))}  ·  {math.round(alpha * 100)}%`
			alphaReadout.Text = `ALPHA {string.format("%.0f", alpha * 100)}%`
			previewFill.BackgroundColor3 = color
			previewFill.BackgroundTransparency = 1 - alpha
			if alphaFill then
				alphaFill.BackgroundColor3 = color
				local gradient = alphaFill:FindFirstChildOfClass("UIGradient")
				if gradient then
					gradient.Color = ColorSequence.new(color)
				end
			end
			if alphaMarker then
				alphaMarker.Position = UDim2.new(alpha, 0, 0.5, 0)
			end
			refreshRow()
		end

		refreshPicker()

		local function updateFromPointer(position: Vector2, final: boolean)
			if not activeDrag then
				return
			end

			if activeDrag == "sv" then
				local size = svContainer.AbsoluteSize
				local origin = svContainer.AbsolutePosition
				if size.X > 0 and size.Y > 0 then
					saturation = clamp01((position.X - origin.X) / size.X)
					value = 1 - clamp01((position.Y - origin.Y) / size.Y)
				end
			elseif activeDrag == "hue" then
				local size = hueContainer.AbsoluteSize
				local origin = hueContainer.AbsolutePosition
				if size.X > 0 then
					hue = clamp01((position.X - origin.X) / size.X)
				end
			elseif activeDrag == "alpha" and alphaContainer then
				local size = alphaContainer.AbsoluteSize
				local origin = alphaContainer.AbsolutePosition
				if size.X > 0 then
					alpha = clamp01((position.X - origin.X) / size.X)
				end
			end

			color = Color3.fromHSV(hue, saturation, value)
			refreshPicker()
			notify(true, final)
		end

		local function beginDrag(kind: string, input: InputObject)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end
			activeDrag = kind
			updateFromPointer(input.Position, false)
		end

		popupBag:Add(svHit.InputBegan:Connect(function(input)
			beginDrag("sv", input)
		end))
		popupBag:Add(hueHit.InputBegan:Connect(function(input)
			beginDrag("hue", input)
		end))
		if alphaHit then
			popupBag:Add(alphaHit.InputBegan:Connect(function(input)
				beginDrag("alpha", input)
			end))
		end

		popupBag:Add(UserInputService.InputChanged:Connect(function(input)
			if not activeDrag then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			then
				updateFromPointer(input.Position, false)
			end
		end))

		popupBag:Add(UserInputService.InputEnded:Connect(function(input)
			if not activeDrag then
				return
			end
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				activeDrag = nil
				notify(false, true)
			end
		end))

		popupBag:Add(hexBox.Focused:Connect(function()
			ctx.Paint(hexStroke, "Color", "Accent")
			hexStroke.Color = ctx.Color("Accent")
		end))

		popupBag:Add(hexBox.FocusLost:Connect(function()
			ctx.Paint(hexStroke, "Color", "Stroke")
			hexStroke.Color = ctx.Color("Stroke")
			local parsed = parseHex(hexBox.Text)
			if parsed then
				color = parsed
				hue, saturation, value = color:ToHSV()
				refreshPicker()
				notify(true, true)
			else
				hexBox.Text = Util.hex(color)
			end
		end))

		popupBag:Add(resetButton.Activated:Connect(function()
			color = initialColor
			alpha = clamp01(options.Alpha or 1)
			hue, saturation, value = color:ToHSV()
			refreshPicker()
			notify(true, true)
		end))

		popupBag:Add(doneButton.Activated:Connect(close))
	end

	bag:Add(swatch.Activated:Connect(function()
		if disabled then
			return
		end
		if popupOpen then
			close()
		else
			open()
		end
	end))

	bag:Add(swatch.MouseEnter:Connect(function()
		if disabled then
			return
		end
		ctx.Paint(swatchStroke, "Color", "Accent")
		swatchStroke.Color = ctx.Color("Accent")
	end))

	bag:Add(swatch.MouseLeave:Connect(function()
		if disabled then
			return
		end
		ctx.Paint(swatchStroke, "Color", "StrokeStrong")
		swatchStroke.Color = ctx.Color("StrokeStrong")
	end))

	local self = setmetatable({} :: any, ColorPicker) :: ColorPicker
	self.Instance = row
	self.Changed = changed
	self.Released = released

	function self:GetColor(): Color3
		return color
	end

	function self:GetAlpha(): number
		return alpha
	end

	function self:SetValue(nextColor: Color3, nextAlpha: number?, silent: boolean?)
		color = nextColor
		if nextAlpha ~= nil then
			alpha = clamp01(nextAlpha)
		end
		hue, saturation, value = color:ToHSV()
		refreshRow()
		if popupOpen then
			close()
		end
		changed:Fire(color, alpha)
		released:Fire(color, alpha)
		if not silent then
			Util.safeCall(callback, color, alpha)
		end
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		swatch.Active = not disabled
		hexLabel.Visible = not disabled
		if disabled then
			close()
			swatchColor.BackgroundTransparency = 0.6
			ctx.Paint(swatchStroke, "Color", "Stroke")
			swatchStroke.Color = ctx.Color("Stroke")
			hexLabel.TextColor3 = ctx.Color("TextFaint")
		else
			refreshRow()
			ctx.Paint(swatchStroke, "Color", "StrokeStrong")
			swatchStroke.Color = ctx.Color("StrokeStrong")
			ctx.Paint(hexLabel, "TextColor3", "TextMuted")
			hexLabel.TextColor3 = ctx.Color("TextMuted")
		end
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (color: Color3, alpha: number) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:OnReleased(handler: (color: Color3, alpha: number) -> ()): Signal.Connection
		return released:Connect(handler)
	end

	function self:Destroy()
		close()
		bag:Clear()
		popupBag:Clear()
		changed:DisconnectAll()
		released:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "ColorPicker")
	ctx.Register(row, labelText)

	return self
end

return ColorPicker
	end

	__modules["Components/Dropdown"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local Dropdown = {}
Dropdown.__index = Dropdown

export type Options = {
	Text: string?,
	Options: { string },
	Default: string?,
	Placeholder: string?,
	Disabled: boolean?,
	Callback: ((value: string) -> ())?,
}

export type Dropdown = {
	Instance: Frame,
	Changed: Signal.Signal,
	GetValue: (self: Dropdown) -> string?,
	SetValue: (self: Dropdown, value: string?, silent: boolean?) -> (),
	SetOptions: (self: Dropdown, options: { string }) -> (),
	GetOptions: (self: Dropdown) -> { string },
	SetDisabled: (self: Dropdown, disabled: boolean) -> (),
	SetVisible: (self: Dropdown, visible: boolean) -> (),
	OnChanged: (self: Dropdown, handler: (value: string) -> ()) -> Signal.Connection,
	Destroy: (self: Dropdown) -> (),
}

function Dropdown.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Dropdown
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local popupBag = Util.bag()
	local items: { string } = table.clone(options.Options or {})
	local value: string? = options.Default
	local disabled = options.Disabled == true
	local labelText = options.Text or "Dropdown"
	local placeholder = options.Placeholder or "Select"
	local callback = options.Callback
	local owner = {}
	local popupOpen = false
	local closeActive: (() -> ())? = nil
	local changed = Signal.new()

	if value ~= nil and not table.find(items, value) then
		value = nil
	end

	local row = Base.row(ctx, parent, labelText)

	local button = Util.textButton({
		Name = "Dropdown",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(160, 32),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Active = not disabled and #items > 0,
	}, row)

	Util.corner(button, theme.Radius.Element)
	local stroke = Util.stroke(button, 1)

	local valueLabel = Base.text(ctx, button, placeholder, {
		Font = theme.Fonts.Mono,
		Size = 13,
		ColorRole = "TextFaint",
		XAlign = Enum.TextXAlignment.Left,
	})
	valueLabel.Position = UDim2.fromOffset(10, 0)
	valueLabel.Size = UDim2.new(1, -38, 1, 0)

	local chevron = Base.chevron(ctx, button, "TextFaint")
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, -10, 0.5, 0)

	local function paintChevron(role: string)
		for _, bar in chevron:GetChildren() do
			if bar:IsA("Frame") then
				ctx.Paint(bar, "BackgroundColor3", role)
				bar.BackgroundColor3 = ctx.Color(role)
			end
		end
	end

	local function updateDisplay()
		if value then
			valueLabel.Text = value
			ctx.Paint(valueLabel, "TextColor3", "Text")
			paintChevron("TextMuted")
		else
			valueLabel.Text = placeholder
			ctx.Paint(valueLabel, "TextColor3", "TextFaint")
			paintChevron("TextFaint")
		end

		valueLabel.TextColor3 = ctx.Color(if value then "Text" else "TextFaint")
	end

	local function applyDisabled()
		button.Active = not disabled and #items > 0
		ctx.Paint(button, "BackgroundColor3", if disabled then "Surface" else "SurfaceRaised")
		button.BackgroundColor3 = ctx.Color(if disabled then "Surface" else "SurfaceRaised")
		button.BackgroundTransparency = if disabled then 0.35 else 0
		ctx.Paint(stroke, "Color", "Stroke")
		stroke.Transparency = if disabled then 0.6 else 0
		ctx.Paint(valueLabel, "TextColor3", if disabled then "TextFaint" else if value then "Text" else "TextFaint")
		valueLabel.TextColor3 = ctx.Color(if disabled then "TextFaint" else if value then "Text" else "TextFaint")
		chevron.Visible = not disabled
		if disabled then
			paintChevron("TextFaint")
		end
	end

	local function close()
		if closeActive then
			local callbackClose = closeActive
			closeActive = nil
			callbackClose()
		end
	end

	local function open()
		if disabled or popupOpen or #items == 0 then
			return
		end

		close()
		popupBag:Clear()

		local height = math.min(#items * 30 + 12, 252)
		local popupFrame, closeFn = ctx.OpenPopup(owner, button, 202, height, function()
			popupOpen = false
			closeActive = nil
			popupBag:Clear()
			Animation.play(chevron, ctx.GetTheme().Motion.Fast, {
				Rotation = 0,
			}, { easing = "Quad" })
		end)

		popupOpen = true
		closeActive = closeFn

		Animation.play(chevron, ctx.GetTheme().Motion.Fast, {
			Rotation = 180,
		}, { easing = "Quad", direction = "Out" })

		local scroller = Util.scrollingFrame({
			Name = "Options",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = ctx.Color("StrokeStrong"),
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, popupFrame)

		Util.padding(scroller, 5, 5)
		Util.list(scroller, 2)

		for index, item in items do
			local selected = value == item

			local optionRow = Util.textButton({
				Name = `Option_{index}`,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, 30),
				Text = "",
				AutoButtonColor = false,
			}, scroller)

			Util.corner(optionRow, theme.Radius.Element - 2)

			local optionLabel = Base.text(ctx, optionRow, item, {
				Font = theme.Fonts.Regular,
				Size = 13,
				ColorRole = if selected then "Accent" else "TextMuted",
				XAlign = Enum.TextXAlignment.Left,
			})
			optionLabel.Position = UDim2.fromOffset(10, 0)
			optionLabel.Size = UDim2.new(1, -30, 1, 0)

			if selected then
				local dot = Util.frame({
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					Size = UDim2.fromOffset(5, 5),
					BorderSizePixel = 0,
				}, optionRow)
				Util.corner(dot, 999)
				ctx.Paint(dot, "BackgroundColor3", "Accent")
			end

			Base.hover(ctx, optionRow, popupBag, if selected then "Accent" else nil, "Hover", if selected then 0.9 else 1, 0)

			popupBag:Add(optionRow.MouseEnter:Connect(function()
				optionLabel.TextColor3 = ctx.Color("Text")
			end))
			popupBag:Add(optionRow.MouseLeave:Connect(function()
				optionLabel.TextColor3 = ctx.Color(if selected then "Accent" else "TextMuted")
			end))

			popupBag:Add(optionRow.Activated:Connect(function()
				value = item
				updateDisplay()
				close()
				changed:Fire(item)
				Util.safeCall(callback, item)
			end))
		end
	end

	do
		local baseRole = "SurfaceRaised"
		button.BackgroundColor3 = ctx.Color(baseRole)
		ctx.Paint(button, "BackgroundColor3", baseRole)
		ctx.Paint(stroke, "Color", "Stroke")

		bag:Add(button.MouseEnter:Connect(function()
			if disabled then
				return
			end
			local current = ctx.GetTheme()
			ctx.Paint(button, "BackgroundColor3", "Hover")
			ctx.Paint(stroke, "Color", "StrokeStrong")
			Animation.play(button, current.Motion.Fast, {
				BackgroundColor3 = ctx.Color("Hover"),
			}, { easing = "Quad" })
			Animation.play(stroke, current.Motion.Fast, {
				Color = ctx.Color("StrokeStrong"),
			}, { easing = "Quad" })
			paintChevron("Text")
		end))

		bag:Add(button.MouseLeave:Connect(function()
			if disabled then
				return
			end
			local current = ctx.GetTheme()
			ctx.Paint(button, "BackgroundColor3", "SurfaceRaised")
			ctx.Paint(stroke, "Color", "Stroke")
			Animation.play(button, current.Motion.Fast, {
				BackgroundColor3 = ctx.Color("SurfaceRaised"),
			}, { easing = "Quad" })
			Animation.play(stroke, current.Motion.Fast, {
				Color = ctx.Color("Stroke"),
			}, { easing = "Quad" })
			paintChevron(if value then "TextMuted" else "TextFaint")
		end))
	end

	bag:Add(button.Activated:Connect(function()
		if popupOpen then
			close()
		else
			open()
		end
	end))

	updateDisplay()
	applyDisabled()

	local self = setmetatable({} :: any, Dropdown) :: Dropdown
	self.Instance = row
	self.Changed = changed

	function self:GetValue(): string?
		return value
	end

	function self:SetValue(nextValue: string?, silent: boolean?)
		if nextValue ~= nil and not table.find(items, nextValue) then
			error(`Kaizax dropdown: "{nextValue}" is not one of the options`, 2)
		end
		if value == nextValue then
			return
		end
		value = nextValue
		updateDisplay()
		changed:Fire(value)
		if not silent then
			Util.safeCall(callback, value)
		end
	end

	function self:SetOptions(nextOptions: { string })
		items = table.clone(nextOptions)

		if value and not table.find(items, value) then
			value = nil
		end

		close()
		updateDisplay()
		applyDisabled()
	end

	function self:GetOptions(): { string }
		return table.clone(items)
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		close()
		applyDisabled()
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (value: string) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:Destroy()
		close()
		bag:Clear()
		popupBag:Clear()
		changed:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "Dropdown")
	ctx.Register(row, labelText)

	return self
end

return Dropdown
	end

	__modules["Components/Keybind"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local UserInputService = game:GetService("UserInputService")

local Keybind = {}
Keybind.__index = Keybind

export type Options = {
	Text: string?,
	Default: Enum.KeyCode?,
	Mode: Types.KeybindMode?,
	ShowMode: boolean?,
	Disabled: boolean?,
	Callback: ((key: Enum.KeyCode?, mode: Types.KeybindMode) -> ())?,
}

export type Keybind = {
	Instance: Frame,
	Changed: Signal.Signal,
	GetKey: (self: Keybind) -> Enum.KeyCode?,
	SetKey: (self: Keybind, key: Enum.KeyCode?, silent: boolean?) -> (),
	GetMode: (self: Keybind) -> Types.KeybindMode,
	SetMode: (self: Keybind, mode: Types.KeybindMode, silent: boolean?) -> (),
	SetDisabled: (self: Keybind, disabled: boolean) -> (),
	SetVisible: (self: Keybind, visible: boolean) -> (),
	OnChanged: (self: Keybind, handler: (key: Enum.KeyCode?, mode: Types.KeybindMode) -> ()) -> Signal.Connection,
	Destroy: (self: Keybind) -> (),
}

local KEY_NAMES: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.LeftShift] = "Shift",
	[Enum.KeyCode.RightShift] = "R-Shift",
	[Enum.KeyCode.LeftControl] = "Ctrl",
	[Enum.KeyCode.RightControl] = "R-Ctrl",
	[Enum.KeyCode.LeftAlt] = "Alt",
	[Enum.KeyCode.RightAlt] = "R-Alt",
	[Enum.KeyCode.Return] = "Enter",
	[Enum.KeyCode.Backspace] = "Backspace",
	[Enum.KeyCode.CapsLock] = "Caps",
	[Enum.KeyCode.Up] = "Up",
	[Enum.KeyCode.Down] = "Down",
	[Enum.KeyCode.Left] = "Left",
	[Enum.KeyCode.Right] = "Right",
	[Enum.KeyCode.ButtonA] = "A",
	[Enum.KeyCode.ButtonB] = "B",
	[Enum.KeyCode.ButtonX] = "X",
	[Enum.KeyCode.ButtonY] = "Y",
	[Enum.KeyCode.ButtonL1] = "LB",
	[Enum.KeyCode.ButtonR1] = "RB",
	[Enum.KeyCode.ButtonL2] = "LT",
	[Enum.KeyCode.ButtonR2] = "RT",
	[Enum.KeyCode.ButtonStart] = "Start",
	[Enum.KeyCode.ButtonSelect] = "Select",
}

local function keyLabel(key: Enum.KeyCode?): string
	if not key then
		return "None"
	end
	return KEY_NAMES[key] or key.Name
end

local activeStop: (() -> ())? = nil

function Keybind.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Keybind
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local key: Enum.KeyCode? = options.Default
	local mode: Types.KeybindMode = options.Mode or "Toggle"
	local showMode = options.ShowMode == true
	local disabled = options.Disabled == true
	local listening = false
	local labelText = options.Text or "Keybind"
	local callback = options.Callback
	local listenConnection: RBXScriptConnection? = nil
	local changed = Signal.new()

	local row, _, rowLabel = Base.row(ctx, parent, labelText)
	if rowLabel then
		rowLabel.Size = UDim2.new(1, if showMode then -204 else -128, 1, 0)
	end

	local bindButton = Util.textButton({
		Name = "Bind",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(120, 32),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Active = not disabled,
	}, row)

	Util.corner(bindButton, theme.Radius.Element)
	local bindStroke = Util.stroke(bindButton, 1)

	local bindLabel = Base.text(ctx, bindButton, keyLabel(key), {
		Font = theme.Fonts.Mono,
		Size = 12,
		ColorRole = if key then "Text" else "TextFaint",
		XAlign = Enum.TextXAlignment.Center,
	})
	bindLabel.Size = UDim2.fromScale(1, 1)

	local modeButton: TextButton? = nil
	local modeLabel: TextLabel? = nil

	if showMode then
		modeButton = Util.textButton({
			Name = "Mode",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -128, 0.5, 0),
			Size = UDim2.fromOffset(60, 32),
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Text = "",
			Active = not disabled,
		}, row)

		Util.corner(modeButton, theme.Radius.Element)
		Util.stroke(modeButton, 1)
		modeLabel = Base.text(ctx, modeButton, mode, {
			Font = theme.Fonts.Medium,
			Size = 11,
			ColorRole = "TextMuted",
			XAlign = Enum.TextXAlignment.Center,
		})
		modeLabel.Size = UDim2.fromScale(1, 1)
		ctx.Paint(modeButton, "BackgroundColor3", "Surface")
		ctx.Paint(modeLabel, "TextColor3", "TextMuted")

		local modeStroke = modeButton:FindFirstChildOfClass("UIStroke")
		if modeStroke then
			ctx.Paint(modeStroke, "Color", "Stroke")
		end
	end

	local function apply(animate: boolean)
		local current = ctx.GetTheme()

		if disabled then
			ctx.Paint(bindButton, "BackgroundColor3", "Surface")
			bindButton.BackgroundColor3 = ctx.Color("Surface")
			bindButton.BackgroundTransparency = 0.35
			ctx.Paint(bindStroke, "Color", "Stroke")
			bindStroke.Transparency = 0.6
			ctx.Paint(bindLabel, "TextColor3", "TextFaint")
			bindLabel.TextColor3 = ctx.Color("TextFaint")
			if modeButton and modeLabel then
				ctx.Paint(modeButton, "BackgroundColor3", "Surface")
				modeButton.BackgroundColor3 = ctx.Color("Surface")
				modeButton.BackgroundTransparency = 0.35
				ctx.Paint(modeLabel, "TextColor3", "TextFaint")
				modeLabel.TextColor3 = ctx.Color("TextFaint")
			end
			return
		end

		local fillRole = if listening then "Accent" else "SurfaceRaised"
		local textRole = if listening then "OnAccent" else if key then "Text" else "TextFaint"
		local strokeRole = if listening then "Accent" else "Stroke"

		ctx.Paint(bindButton, "BackgroundColor3", fillRole)
		ctx.Paint(bindLabel, "TextColor3", textRole)
		ctx.Paint(bindStroke, "Color", strokeRole)
		bindButton.BackgroundTransparency = 0
		bindStroke.Transparency = if listening then 0.2 else 0
		bindLabel.Text = if listening then "Listening..." else keyLabel(key)

		if animate then
			Animation.play(bindButton, current.Motion.Fast, {
				BackgroundTransparency = 0,
				BackgroundColor3 = if listening then current.Palette.Accent else current.Palette.SurfaceRaised,
			}, { easing = "Quad" })
			Animation.play(bindStroke, current.Motion.Fast, {
				Transparency = if listening then 0.2 else 0,
				Color = ctx.Color(strokeRole),
			}, { easing = "Quad" })
		else
			bindButton.BackgroundColor3 = if listening then current.Palette.Accent else current.Palette.SurfaceRaised
		end

		bindButton.Active = not disabled
		bindLabel.TextColor3 = ctx.Color(textRole)

		if modeButton and modeLabel then
			modeButton.Active = not disabled
			ctx.Paint(modeButton, "BackgroundColor3", "Surface")
			ctx.Paint(modeLabel, "TextColor3", "TextMuted")
			modeLabel.Text = mode
			modeButton.BackgroundColor3 = ctx.Color("Surface")
			modeButton.BackgroundTransparency = 0
			modeLabel.TextColor3 = ctx.Color("TextMuted")
		end
	end

	local function stopListening()
		if listenConnection then
			listenConnection:Disconnect()
			listenConnection = nil
		end
		listening = false
		if activeStop == stopListening then
			activeStop = nil
		end
		apply(true)
	end

	local function emit(fromUser: boolean)
		changed:Fire(key, mode)
		if fromUser then
			Util.safeCall(callback, key, mode)
		end
	end

	local function setKey(nextKey: Enum.KeyCode?, fromUser: boolean)
		key = nextKey
		apply(true)
		emit(fromUser)
	end

	local function startListening()
		if disabled or listening then
			return
		end

		if activeStop and activeStop ~= stopListening then
			activeStop()
		end

		listening = true
		activeStop = stopListening
		apply(true)

		listenConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if not listening then
				return
			end
			if gameProcessed then
				return
			end

			if input.KeyCode == Enum.KeyCode.Escape then
				stopListening()
				return
			end

			if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
				stopListening()
				setKey(nil, true)
				return
			end

			local kind = input.UserInputType
			if kind == Enum.UserInputType.Keyboard
				or kind == Enum.UserInputType.Gamepad1
				or kind == Enum.UserInputType.Gamepad2
				or kind == Enum.UserInputType.Gamepad3
				or kind == Enum.UserInputType.Gamepad4
			then
				stopListening()
				setKey(input.KeyCode, true)
			end
		end)
	end

	apply(false)

	bag:Add(bindButton.Activated:Connect(function()
		if disabled then
			return
		end
		if listening then
			stopListening()
		else
			startListening()
		end
	end))

	bag:Add(bindButton.MouseEnter:Connect(function()
		if disabled or listening then
			return
		end
		local current = ctx.GetTheme()
		ctx.Paint(bindButton, "BackgroundColor3", "Hover")
		ctx.Paint(bindStroke, "Color", "StrokeStrong")
		Animation.play(bindButton, current.Motion.Fast, {
			BackgroundColor3 = ctx.Color("Hover"),
		}, { easing = "Quad" })
		Animation.play(bindStroke, current.Motion.Fast, {
			Color = ctx.Color("StrokeStrong"),
		}, { easing = "Quad" })
	end))

	bag:Add(bindButton.MouseLeave:Connect(function()
		if disabled or listening then
			return
		end
		apply(true)
	end))

	if modeButton then
		bag:Add(modeButton.Activated:Connect(function()
			if disabled then
				return
			end
			mode = if mode == "Hold" then "Toggle" else "Hold"
			apply(true)
			emit(true)
		end))

		bag:Add(modeButton.MouseEnter:Connect(function()
			if disabled then
				return
			end
			local current = ctx.GetTheme()
			ctx.Paint(modeButton, "BackgroundColor3", "Hover")
			Animation.play(modeButton, current.Motion.Fast, {
				BackgroundColor3 = ctx.Color("Hover"),
			}, { easing = "Quad" })
		end))

		bag:Add(modeButton.MouseLeave:Connect(function()
			if disabled then
				return
			end
			ctx.Paint(modeButton, "BackgroundColor3", "Surface")
			Animation.play(modeButton, ctx.GetTheme().Motion.Fast, {
				BackgroundColor3 = ctx.Color("Surface"),
			}, { easing = "Quad" })
		end))
	end

	local self = setmetatable({} :: any, Keybind) :: Keybind
	self.Instance = row
	self.Changed = changed

	function self:GetKey(): Enum.KeyCode?
		return key
	end

	function self:SetKey(nextKey: Enum.KeyCode?, silent: boolean?)
		key = nextKey
		apply(true)
		if not silent then
			emit(false)
		end
	end

	function self:GetMode(): Types.KeybindMode
		return mode
	end

	function self:SetMode(nextMode: Types.KeybindMode, silent: boolean?)
		mode = nextMode
		apply(true)
		if not silent then
			emit(false)
		end
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		bindButton.Active = not disabled
		if modeButton then
			modeButton.Active = not disabled
		end
		if disabled then
			stopListening()
		end
		apply(true)
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (key: Enum.KeyCode?, mode: Types.KeybindMode) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:Destroy()
		stopListening()
		bag:Clear()
		changed:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "Keybind")
	ctx.Register(row, labelText)

	return self
end

return Keybind
	end

	__modules["Components/MultiDropdown"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local MultiDropdown = {}
MultiDropdown.__index = MultiDropdown

export type Options = {
	Text: string?,
	Options: { string },
	Default: { string }?,
	Placeholder: string?,
	Disabled: boolean?,
	Callback: ((values: { string }) -> ())?,
}

export type MultiDropdown = {
	Instance: Frame,
	Changed: Signal.Signal,
	GetValue: (self: MultiDropdown) -> { string },
	SetValue: (self: MultiDropdown, values: { string }, silent: boolean?) -> (),
	Clear: (self: MultiDropdown, silent: boolean?) -> (),
	SetOptions: (self: MultiDropdown, options: { string }) -> (),
	GetOptions: (self: MultiDropdown) -> { string },
	SetDisabled: (self: MultiDropdown, disabled: boolean) -> (),
	SetVisible: (self: MultiDropdown, visible: boolean) -> (),
	OnChanged: (self: MultiDropdown, handler: (values: { string }) -> ()) -> Signal.Connection,
	Destroy: (self: MultiDropdown) -> (),
}

function MultiDropdown.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): MultiDropdown
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local popupBag = Util.bag()
	local items: { string } = table.clone(options.Options or {})
	local selected: { [string]: boolean } = {}
	local disabled = options.Disabled == true
	local labelText = options.Text or "Select"
	local placeholder = options.Placeholder or "None selected"
	local callback = options.Callback
	local owner = {}
	local popupOpen = false
	local closeActive: (() -> ())? = nil
	local changed = Signal.new()

	for _, item in options.Default or {} do
		if table.find(items, item) then
			selected[item] = true
		end
	end

	local function getValues(): { string }
		local values = {}
		for _, item in items do
			if selected[item] then
				table.insert(values, item)
			end
		end
		return values
	end

	local row = Base.row(ctx, parent, labelText)

	local button = Util.textButton({
		Name = "MultiDropdown",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(184, 32),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Active = not disabled and #items > 0,
	}, row)

	Util.corner(button, theme.Radius.Element)
	local stroke = Util.stroke(button, 1)

	local valueLabel = Base.text(ctx, button, placeholder, {
		Font = theme.Fonts.Mono,
		Size = 13,
		ColorRole = "TextFaint",
		XAlign = Enum.TextXAlignment.Left,
	})
	valueLabel.Position = UDim2.fromOffset(10, 0)
	valueLabel.Size = UDim2.new(1, -38, 1, 0)

	local chevron = Base.chevron(ctx, button, "TextFaint")
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, -10, 0.5, 0)

	local function paintChevron(role: string)
		for _, bar in chevron:GetChildren() do
			if bar:IsA("Frame") then
				ctx.Paint(bar, "BackgroundColor3", role)
				bar.BackgroundColor3 = ctx.Color(role)
			end
		end
	end

	local function updateDisplay()
		local values = getValues()
		if #values == 0 then
			valueLabel.Text = placeholder
			ctx.Paint(valueLabel, "TextColor3", "TextFaint")
			paintChevron("TextFaint")
		elseif #values == 1 then
			valueLabel.Text = values[1]
			ctx.Paint(valueLabel, "TextColor3", "Text")
			paintChevron("TextMuted")
		elseif #values == 2 then
			valueLabel.Text = `{values[1]}, {values[2]}`
			ctx.Paint(valueLabel, "TextColor3", "Text")
			paintChevron("TextMuted")
		else
			valueLabel.Text = `{values[1]}, {values[2]} +{#values - 2}`
			ctx.Paint(valueLabel, "TextColor3", "Text")
			paintChevron("TextMuted")
		end

		valueLabel.TextColor3 = ctx.Color(if #values == 0 then "TextFaint" else "Text")
	end

	local function applyDisabled()
		button.Active = not disabled and #items > 0
		ctx.Paint(button, "BackgroundColor3", if disabled then "Surface" else "SurfaceRaised")
		button.BackgroundColor3 = ctx.Color(if disabled then "Surface" else "SurfaceRaised")
		button.BackgroundTransparency = if disabled then 0.35 else 0
		ctx.Paint(stroke, "Color", "Stroke")
		stroke.Transparency = if disabled then 0.6 else 0
		ctx.Paint(valueLabel, "TextColor3", if disabled then "TextFaint" else "Text")
		valueLabel.TextColor3 = ctx.Color(if disabled then "TextFaint" else "Text")
		chevron.Visible = not disabled
		if disabled then
			paintChevron("TextFaint")
		end
	end

	local function emit(notifyCallback: boolean)
		local values = getValues()
		changed:Fire(values)
		if notifyCallback then
			Util.safeCall(callback, table.clone(values))
		end
	end

	local function close()
		if closeActive then
			local callbackClose = closeActive
			closeActive = nil
			callbackClose()
		end
	end

	local function makeFooterButton(footer: Frame, text: string, primary: boolean, order: number): TextButton
		local footerButton = Util.textButton({
			Name = text,
			BackgroundColor3 = ctx.Color(if primary then "Accent" else "SurfaceRaised"),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(58, 26),
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
		}, footer)

		Util.corner(footerButton, theme.Radius.Element - 2)
		ctx.Paint(footerButton, "BackgroundColor3", if primary then "Accent" else "SurfaceRaised")

		local label = Base.text(ctx, footerButton, text, {
			Font = theme.Fonts.Medium,
			Size = 11,
			ColorRole = if primary then "OnAccent" else "TextMuted",
			XAlign = Enum.TextXAlignment.Center,
		})
		label.Size = UDim2.fromScale(1, 1)

		return footerButton
	end

	local function open()
		if disabled or popupOpen or #items == 0 then
			return
		end

		close()
		popupBag:Clear()

		local height = math.min(#items * 30 + 52, 300)
		local popupFrame, closeFn = ctx.OpenPopup(owner, button, 224, height, function()
			popupOpen = false
			closeActive = nil
			popupBag:Clear()
			Animation.play(chevron, ctx.GetTheme().Motion.Fast, {
				Rotation = 0,
			}, { easing = "Quad" })
		end)

		popupOpen = true
		closeActive = closeFn

		Animation.play(chevron, ctx.GetTheme().Motion.Fast, {
			Rotation = 180,
		}, { easing = "Quad", direction = "Out" })

		local scroller = Util.scrollingFrame({
			Name = "Options",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1, -40),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = ctx.Color("StrokeStrong"),
			ScrollingDirection = Enum.ScrollingDirection.Y,
		}, popupFrame)

		Util.padding(scroller, 5, 5)
		Util.list(scroller, 2)

		local boxes: { [string]: { box: Frame, stroke: UIStroke, check: UIScale, label: TextLabel } } = {}

		local function paintOption(item: string)
			local entry = boxes[item]
			if not entry then
				return
			end

			local isSelected = selected[item] == true
			ctx.Paint(entry.box, "BackgroundColor3", if isSelected then "Accent" else "SurfaceRaised")
			ctx.Paint(entry.stroke, "Color", if isSelected then "Accent" else "Stroke")
			ctx.Paint(entry.label, "TextColor3", if isSelected then "Text" else "TextMuted")
			Animation.play(entry.box, ctx.GetTheme().Motion.Fast, {
				BackgroundColor3 = ctx.Color(if isSelected then "Accent" else "SurfaceRaised"),
			}, { easing = "Quad" })
			entry.stroke.Transparency = if isSelected then 1 else 0.4
			Animation.play(entry.check, ctx.GetTheme().Motion.Fast, {
				Scale = if isSelected then 1 else 0,
			}, { easing = "Quad", direction = "Out" })
		end

		for index, item in items do
			local optionRow = Util.textButton({
				Name = `Option_{index}`,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = index,
				Size = UDim2.new(1, 0, 0, 30),
				Text = "",
				AutoButtonColor = false,
			}, scroller)

			Util.corner(optionRow, theme.Radius.Element - 2)

			local box = Util.frame({
				Name = "Checkbox",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 1, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = ctx.Color("SurfaceRaised"),
				BorderSizePixel = 0,
			}, optionRow)

			Util.corner(box, theme.Radius.Element - 4)
			local boxStroke = Util.stroke(box, 1)

			local checkContainer = Util.frame({
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
			}, box)

			local checkScale = Util.create("UIScale", {
				Scale = if selected[item] then 1 else 0,
			}, checkContainer) :: UIScale

			local barOne = Util.frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = ctx.Color("OnAccent"),
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(4, 8),
				Rotation = 45,
				Size = UDim2.fromOffset(2, 5),
			}, checkContainer)
			Util.corner(barOne, 1)
			ctx.Paint(barOne, "BackgroundColor3", "OnAccent")

			local barTwo = Util.frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = ctx.Color("OnAccent"),
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(8, 7),
				Rotation = -48,
				Size = UDim2.fromOffset(2, 8),
			}, checkContainer)
			Util.corner(barTwo, 1)
			ctx.Paint(barTwo, "BackgroundColor3", "OnAccent")

			local optionLabel = Base.text(ctx, optionRow, item, {
				Font = theme.Fonts.Regular,
				Size = 13,
				ColorRole = if selected[item] then "Text" else "TextMuted",
				XAlign = Enum.TextXAlignment.Left,
			})
			optionLabel.Position = UDim2.fromOffset(26, 0)
			optionLabel.Size = UDim2.new(1, -36, 1, 0)

			boxes[item] = {
				box = box,
				stroke = boxStroke,
				check = checkScale,
				label = optionLabel,
			}

			Base.hover(ctx, optionRow, popupBag, nil, "Hover", 1, 0)

			popupBag:Add(optionRow.Activated:Connect(function()
				if selected[item] then
					selected[item] = nil
				else
					selected[item] = true
				end
				paintOption(item)
				updateDisplay()
				emit(true)
			end))
		end

		local divider = Util.frame({
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = ctx.Color("Stroke"),
			BorderSizePixel = 0,
			Position = UDim2.new(0.5, 0, 1, -34),
			Size = UDim2.new(1, -12, 0, 1),
		}, popupFrame)
		ctx.Paint(divider, "BackgroundColor3", "Stroke")

		local footer = Util.frame({
			Name = "Footer",
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundTransparency = 1,
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.new(1, -12, 0, 34),
		}, popupFrame)

		Util.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, footer)

		local clearButton = makeFooterButton(footer, "Clear", false, 1)
		local doneButton = makeFooterButton(footer, "Done", true, 2)

		Base.hover(ctx, clearButton, popupBag, "SurfaceRaised", "Hover", 0, 0)
		Base.hover(ctx, doneButton, popupBag, "Accent", "Accent", 0, 0)

		popupBag:Add(clearButton.Activated:Connect(function()
			table.clear(selected)
			for item in boxes do
				paintOption(item)
			end
			updateDisplay()
			emit(true)
		end))

		popupBag:Add(doneButton.Activated:Connect(close))
	end

	do
		local baseRole = "SurfaceRaised"
		button.BackgroundColor3 = ctx.Color(baseRole)
		ctx.Paint(button, "BackgroundColor3", baseRole)
		ctx.Paint(stroke, "Color", "Stroke")

		bag:Add(button.MouseEnter:Connect(function()
			if disabled then
				return
			end
			local current = ctx.GetTheme()
			ctx.Paint(button, "BackgroundColor3", "Hover")
			ctx.Paint(stroke, "Color", "StrokeStrong")
			Animation.play(button, current.Motion.Fast, {
				BackgroundColor3 = ctx.Color("Hover"),
			}, { easing = "Quad" })
			Animation.play(stroke, current.Motion.Fast, {
				Color = ctx.Color("StrokeStrong"),
			}, { easing = "Quad" })
			paintChevron("Text")
		end))

		bag:Add(button.MouseLeave:Connect(function()
			if disabled then
				return
			end
			local current = ctx.GetTheme()
			ctx.Paint(button, "BackgroundColor3", "SurfaceRaised")
			ctx.Paint(stroke, "Color", "Stroke")
			Animation.play(button, current.Motion.Fast, {
				BackgroundColor3 = ctx.Color("SurfaceRaised"),
			}, { easing = "Quad" })
			Animation.play(stroke, current.Motion.Fast, {
				Color = ctx.Color("Stroke"),
			}, { easing = "Quad" })
			paintChevron(if #getValues() > 0 then "TextMuted" else "TextFaint")
		end))
	end

	bag:Add(button.Activated:Connect(function()
		if popupOpen then
			close()
		else
			open()
		end
	end))

	updateDisplay()
	applyDisabled()

	local self = setmetatable({} :: any, MultiDropdown) :: MultiDropdown
	self.Instance = row
	self.Changed = changed

	function self:GetValue(): { string }
		return getValues()
	end

	function self:SetValue(values: { string }, silent: boolean?)
		table.clear(selected)
		for _, item in values do
			if table.find(items, item) then
				selected[item] = true
			end
		end
		updateDisplay()
		if not silent then
			emit(true)
		end
	end

	function self:Clear(silent: boolean?)
		if next(selected) == nil then
			return
		end
		table.clear(selected)
		updateDisplay()
		if not silent then
			emit(true)
		end
	end

	function self:SetOptions(nextOptions: { string })
		items = table.clone(nextOptions)

		for item in selected do
			if not table.find(items, item) then
				selected[item] = nil
			end
		end

		close()
		updateDisplay()
		applyDisabled()
	end

	function self:GetOptions(): { string }
		return table.clone(items)
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		close()
		applyDisabled()
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (values: { string }) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:Destroy()
		close()
		bag:Clear()
		popupBag:Clear()
		changed:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "MultiDropdown")
	ctx.Register(row, labelText)

	return self
end

return MultiDropdown
	end

	__modules["Components/Search"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")

local Search = {}
Search.__index = Search

export type Options = {
	Placeholder: string?,
	Width: number?,
	Height: number?,
	Callback: ((text: string) -> ())?,
}

export type Search = {
	Instance: Frame,
	Changed: Signal.Signal,
	GetText: (self: Search) -> string,
	SetText: (self: Search, text: string, silent: boolean?) -> (),
	Clear: (self: Search, silent: boolean?) -> (),
	Focus: (self: Search) -> (),
	OnChanged: (self: Search, handler: (text: string) -> ()) -> Signal.Connection,
	Destroy: (self: Search) -> (),
}

function Search.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Search
	local theme = ctx.GetTheme()
	local bag = Util.bag()
	local text = ""
	local focused = false
	local hovered = false
	local callback = options.Callback
	local placeholder = options.Placeholder or "Search controls"
	local changed = Signal.new()

	local frame = Util.frame({
		Name = "Search",
		BackgroundColor3 = theme.Palette.Surface,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(options.Width or 216, options.Height or 32),
	}, parent)

	Util.corner(frame, theme.Radius.Element)
	local stroke = Util.stroke(frame, 1)
	local strokeTransparency = stroke.Transparency
	ctx.Paint(frame, "BackgroundColor3", "Surface")
	ctx.Paint(stroke, "Color", "Stroke")

	local icon = Util.frame({
		Name = "Icon",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.fromOffset(16, 32),
	}, frame)
	local iconScale = Util.create("UIScale", { Scale = 1 }, icon) :: UIScale

	local ring = Util.frame({
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(6.5, 15),
		Size = UDim2.fromOffset(9, 9),
	}, icon)
	Util.corner(ring, 999)
	local ringStroke = Util.stroke(ring, 1.5)
	ctx.Paint(ringStroke, "Color", "TextFaint")

	local handle = Util.frame({
		Name = "Handle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.Palette.TextFaint,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12.5, 21),
		Rotation = 45,
		Size = UDim2.fromOffset(6.5, 1.5),
	}, icon)
	Util.corner(handle, 1)
	ctx.Paint(handle, "BackgroundColor3", "TextFaint")

	local field = Util.textBox({
		Name = "Field",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = theme.Fonts.Regular,
		MultiLine = false,
		PlaceholderColor3 = theme.Palette.TextFaint,
		PlaceholderText = placeholder,
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -64, 1, 0),
		Text = "",
		TextColor3 = theme.Palette.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, frame)

	ctx.Paint(field, "TextColor3", "Text")
	ctx.Paint(field, "PlaceholderColor3", "TextFaint")

	local clearButton = Util.textButton({
		Name = "Clear",
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(20, 20),
		Text = "",
		AutoButtonColor = false,
		Visible = false,
	}, frame)

	local barOne = Util.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.Palette.TextMuted,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Rotation = 45,
		Size = UDim2.fromOffset(7, 1),
	}, clearButton)
	ctx.Paint(barOne, "BackgroundColor3", "TextMuted")

	local barTwo = Util.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = theme.Palette.TextMuted,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Rotation = -45,
		Size = UDim2.fromOffset(7, 1),
	}, clearButton)
	ctx.Paint(barTwo, "BackgroundColor3", "TextMuted")

	local function paintIcon(role: string, animate: boolean)
		if animate then
			Util.paint(ringStroke, "Color", role)
			Util.paint(handle, "BackgroundColor3", role)
		else
			ctx.Paint(ringStroke, "Color", role)
			ctx.Paint(handle, "BackgroundColor3", role)
		end
	end

	local function apply(animate: boolean)
		local targetFrame = if focused then "SurfaceRaised" elseif hovered then "Hover" else "Surface"
		local targetStroke = if focused then "Accent" elseif hovered then "StrokeStrong" else "Stroke"
		local targetStrokeTransparency = if focused then 0 elseif hovered then 0.06 else strokeTransparency
		local iconRole = if focused then "Accent" elseif hovered then "TextMuted" else "TextFaint"

		if animate then
			Util.paint(frame, "BackgroundColor3", targetFrame)
			Util.paint(stroke, "Color", targetStroke)
			paintIcon(iconRole, true)

			Animation.play(frame, Animation.MOTION.Hover.Duration, {
				BackgroundColor3 = ctx.Color(targetFrame),
			}, { easing = "Quad" })
			Animation.play(stroke, Animation.MOTION.Hover.Duration, {
				Color = ctx.Color(targetStroke),
				Transparency = targetStrokeTransparency,
			}, { easing = Animation.MOTION.Hover.Easing })
			Animation.play(ringStroke, Animation.MOTION.Hover.Duration, {
				Color = ctx.Color(iconRole),
			}, { easing = "Quad" })
			Animation.play(handle, Animation.MOTION.Hover.Duration, {
				BackgroundColor3 = ctx.Color(iconRole),
			}, { easing = "Quad" })
			Animation.play(iconScale, Animation.MOTION.Press.Duration, {
				Scale = if focused then 1.08 else 1,
			}, { easing = "Quad" })
		else
			ctx.Paint(frame, "BackgroundColor3", targetFrame)
			ctx.Paint(stroke, "Color", targetStroke)
			paintIcon(iconRole, false)
			frame.BackgroundColor3 = ctx.Color(targetFrame)
			stroke.Color = ctx.Color(targetStroke)
			stroke.Transparency = targetStrokeTransparency
			ringStroke.Color = ctx.Color(iconRole)
			handle.BackgroundColor3 = ctx.Color(iconRole)
			iconScale.Scale = if focused then 1.08 else 1
		end
	end

	local function syncClear()
		clearButton.Visible = text ~= ""
	end

	local function emit(textValue: string, silent: boolean?)
		changed:Fire(textValue)
		if not silent then
			Util.safeCall(callback, textValue)
		end
	end

	apply(false)
	syncClear()

	bag:Add(field:GetPropertyChangedSignal("Text"):Connect(function()
		text = field.Text
		syncClear()
		emit(text, false)
	end))

	bag:Add(field.Focused:Connect(function()
		focused = true
		apply(true)
	end))

	bag:Add(field.FocusLost:Connect(function()
		focused = false
		hovered = false
		apply(true)
	end))

	bag:Add(field.MouseEnter:Connect(function()
		hovered = true
		if not focused then
			apply(true)
		end
	end))

	bag:Add(field.MouseLeave:Connect(function()
		hovered = false
		if not focused then
			apply(true)
		end
	end))

	bag:Add(clearButton.Activated:Connect(function()
		field.Text = ""
		text = ""
		syncClear()
		emit("", false)
		field:CaptureFocus()
	end))

	local self = setmetatable({} :: any, Search) :: Search
	self.Instance = frame
	self.Changed = changed

	function self:GetText(): string
		return text
	end

	function self:SetText(nextText: string, silent: boolean?)
		text = nextText
		field.Text = nextText
		syncClear()
		if not silent then
			emit(nextText, false)
		end
	end

	function self:Clear(silent: boolean?)
		if text == "" then
			return
		end
		text = ""
		field.Text = ""
		syncClear()
		if not silent then
			emit("", false)
		end
	end

	function self:Focus()
		field:CaptureFocus()
	end

	function self:OnChanged(handler: (nextText: string) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:Destroy()
		bag:Clear()
		changed:DisconnectAll()
		frame:Destroy()
	end

	ctx.Register(frame, nil)
	return self
end

return Search
	end

	__modules["Components/Slider"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
local Animation = __require("Animation")
local Signal = __require("Signal")
local Base = __require("Components/Base")

local UserInputService = game:GetService("UserInputService")

local Slider = {}
Slider.__index = Slider

export type Options = {
	Text: string?,
	Min: number?,
	Max: number?,
	Default: number?,
	Step: number?,
	Suffix: string?,
	Format: ((value: number) -> string)?,
	Live: boolean?,
	Disabled: boolean?,
	Callback: ((value: number) -> ())?,
}

export type Slider = {
	Instance: Frame,
	Changed: Signal.Signal,
	Released: Signal.Signal,
	GetValue: (self: Slider) -> number,
	SetValue: (self: Slider, value: number) -> (),
	SetRange: (self: Slider, minimum: number, maximum: number) -> (),
	GetRange: (self: Slider) -> (number, number),
	SetDisabled: (self: Slider, disabled: boolean) -> (),
	SetVisible: (self: Slider, visible: boolean) -> (),
	OnChanged: (self: Slider, handler: (value: number) -> ()) -> Signal.Connection,
	OnReleased: (self: Slider, handler: (value: number) -> ()) -> Signal.Connection,
	Destroy: (self: Slider) -> (),
}

function Slider.new(
	ctx: Types.UIContext,
	parent: Instance,
	options: Options
): Slider
	local theme = ctx.GetTheme()
	local bag = Util.bag()

	local minimum = options.Min or 0
	local maximum = options.Max or 100
	if maximum <= minimum then
		error("Kaizax slider: Max must be greater than Min", 2)
	end

	local step = options.Step or 1
	if step <= 0 then
		error("Kaizax slider: Step must be greater than zero", 2)
	end

	local suffix = options.Suffix or ""
	local callback = options.Callback
	local live = options.Live == true
	local disabled = options.Disabled == true
	local labelText = options.Text or "Slider"
	local dragging = false
	local hovered = false
	local value = Util.round(math.clamp(options.Default or minimum, minimum, maximum), step)
	local changed = Signal.new()
	local released = Signal.new()

	local row = Util.frame({
		Name = "Slider",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
	}, parent)

	local label = Base.text(ctx, row, labelText, {
		Font = theme.Fonts.Medium,
		Size = 13,
		ColorRole = "TextMuted",
	})
	label.Position = UDim2.fromOffset(0, 2)
	label.Size = UDim2.new(1, -84, 0, 18)

	local valueLabel = Base.text(ctx, row, "", {
		Font = theme.Fonts.Mono,
		Size = 13,
		ColorRole = "TextMuted",
		XAlign = Enum.TextXAlignment.Right,
	})
	valueLabel.AnchorPoint = Vector2.new(1, 0)
	valueLabel.Position = UDim2.new(1, 0, 0, 2)
	valueLabel.Size = UDim2.fromOffset(84, 18)

	local trackHit = Util.textButton({
		Name = "TrackHit",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		Text = "",
		AutoButtonColor = false,
		Active = not disabled,
	}, row)

	local track = Util.frame({
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 6, 0.5, 0),
		Size = UDim2.new(1, -12, 0, 6),
		BorderSizePixel = 0,
	}, trackHit)

	Util.corner(track, 999)

	local fill = Util.frame({
		Name = "Fill",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}, track)

	Util.corner(fill, 999)

	local knob = Util.frame({
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BorderSizePixel = 0,
		ZIndex = 3,
	}, track)

	Util.corner(knob, 999)

	local knobCore = Util.frame({
		Name = "Core",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(5, 5),
		BorderSizePixel = 0,
	}, knob)

	Util.corner(knobCore, 999)

	local knobScale = Util.create("UIScale", {
		Scale = 1,
	}, knob) :: UIScale

	local function fraction(): number
		return (value - minimum) / (maximum - minimum)
	end

	local function display(): string
		if options.Format then
			local ok, text = pcall(options.Format, value)
			if ok and typeof(text) == "string" then
				return text
			end
		end
		return Util.formatNumber(value, step, suffix)
	end

	local function applyColors(animate: boolean)
		local current = ctx.GetTheme()
		local active = dragging or hovered

		if disabled then
			ctx.Paint(track, "BackgroundColor3", "Stroke")
			ctx.Paint(fill, "BackgroundColor3", "TextFaint")
			ctx.Paint(knob, "BackgroundColor3", "TextFaint")
			ctx.Paint(knobCore, "BackgroundColor3", "Surface")
			ctx.Paint(valueLabel, "TextColor3", "TextFaint")
			track.BackgroundTransparency = 0.5
			fill.BackgroundTransparency = 0.6
			knob.BackgroundTransparency = 0.4
			return
		end

		ctx.Paint(track, "BackgroundColor3", if active then "StrokeStrong" else "Stroke")
		ctx.Paint(fill, "BackgroundColor3", "Accent")
		ctx.Paint(knob, "BackgroundColor3", "Accent")
		ctx.Paint(knobCore, "BackgroundColor3", "OnAccent")
		ctx.Paint(valueLabel, "TextColor3", if active then "Accent" else "TextMuted")
		track.BackgroundTransparency = 0
		fill.BackgroundTransparency = 0
		knob.BackgroundTransparency = 0

		local targetScale = if active then 1.12 else 1
		if animate then
			Animation.play(knobScale, current.Motion.Fast, { Scale = targetScale }, { easing = "Quad" })
			Animation.play(track, current.Motion.Fast, {
				BackgroundColor3 = ctx.Color(if active then "StrokeStrong" else "Stroke"),
			}, { easing = "Quad" })
		else
			knobScale.Scale = targetScale
		end
	end

	local function updateVisuals(animate: boolean)
		local position = fraction()
		local target = UDim2.fromScale(position, 0.5)
		fill.Size = UDim2.fromScale(position, 1)
		knob.Position = target
		valueLabel.Text = display()
		applyColors(animate)
	end

	local function setValue(nextValue: number, fromUser: boolean, final: boolean)
		local clamped = Util.round(math.clamp(nextValue, minimum, maximum), step)
		if clamped == value then
			if final and fromUser then
				released:Fire(value)
				Util.safeCall(callback, value)
			end
			return
		end

		value = clamped
		updateVisuals(false)
		changed:Fire(value)

		if fromUser and live and not final then
			Util.safeCall(callback, value)
		end

		if final then
			released:Fire(value)
			Util.safeCall(callback, value)
		end
	end

	local function updateFromInput(positionX: number, final: boolean)
		local width = track.AbsoluteSize.X
		if width <= 0 then
			return
		end
		local relative = (positionX - track.AbsolutePosition.X) / width
		local nextValue = minimum + math.clamp(relative, 0, 1) * (maximum - minimum)
		setValue(nextValue, true, final)
	end

	updateVisuals(false)

	bag:Add(trackHit.InputBegan:Connect(function(input)
		if disabled then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end
		dragging = true
		updateFromInput(input.Position.X, false)
	end))

	bag:Add(UserInputService.InputChanged:Connect(function(input)
		if not dragging or disabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			updateFromInput(input.Position.X, false)
		end
	end))

	bag:Add(UserInputService.InputEnded:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
			updateFromInput(input.Position.X, true)
			applyColors(true)
		end
	end))

	bag:Add(trackHit.MouseEnter:Connect(function()
		if disabled then
			return
		end
		hovered = true
		applyColors(true)
	end))

	bag:Add(trackHit.MouseLeave:Connect(function()
		if disabled then
			return
		end
		hovered = false
		applyColors(true)
	end))

	local self = setmetatable({} :: any, Slider) :: Slider
	self.Instance = row
	self.Changed = changed
	self.Released = released

	function self:GetValue(): number
		return value
	end

	function self:SetValue(nextValue: number)
		setValue(nextValue, false, false)
	end

	function self:SetRange(nextMinimum: number, nextMaximum: number)
		if nextMaximum <= nextMinimum then
			error("Kaizax slider: Max must be greater than Min", 2)
		end
		minimum = nextMinimum
		maximum = nextMaximum
		value = Util.round(math.clamp(value, minimum, maximum), step)
		updateVisuals(false)
	end

	function self:GetRange(): (number, number)
		return minimum, maximum
	end

	function self:SetDisabled(nextDisabled: boolean)
		if disabled == nextDisabled then
			return
		end
		disabled = nextDisabled
		trackHit.Active = not disabled
		if disabled then
			dragging = false
		end
		applyColors(true)
	end

	function self:SetVisible(visible: boolean)
		row.Visible = visible
	end

	function self:OnChanged(handler: (value: number) -> ()): Signal.Connection
		return changed:Connect(handler)
	end

	function self:OnReleased(handler: (value: number) -> ()): Signal.Connection
		return released:Connect(handler)
	end

	function self:Destroy()
		bag:Clear()
		changed:DisconnectAll()
		released:DisconnectAll()
		row:Destroy()
	end

	row:SetAttribute("KaizaxComponent", "Slider")
	ctx.Register(row, labelText)

	return self
end

return Slider
	end

	__modules["Components/TextInput"] = function()
--!strict

local Types = __require("Types")
local Util = __require("Util")
